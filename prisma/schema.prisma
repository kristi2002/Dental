// DentOrganizer — dental practice organizer & CRM
// No billing / payment / fiscalization models by design.

// Prisma 7 moved the connection URL out of the schema — see `prisma.config.ts`,
// which reads DATABASE_URL from `.env`.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// Who may do what. One row per person who touches the app; there is no
/// self-service signup — the owner creates every account from the Staff page.
model StaffUser {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  role      Role    @default(RECEPTIONIST)
  /// scrypt digest of the PIN, hex. Never the PIN itself.
  pinHash   String
  pinSalt   String
  /// Deactivating keeps the audit trail intact; deleting a person would not.
  active    Boolean @default(true)

  /// Brute-force guard for a 4–6 digit secret: lock the account, not the device.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntries   AuditLog[]
  visitRecords   VisitRecord[]    @relation("VisitRecorder")
  visitsPerformed VisitRecord[]   @relation("VisitPerformer")
  stockMovements StockMovement[]
  documents      PatientDocument[]
  prescriptions  Prescription[]
  appointments   Appointment[]
  leave          Closure[]
  contacts       Contact[]
  alertsCreated  PatientAlert[]

  /// Three roles on one board: who wrote the line, whose job it is, who ticked
  /// it off. Named relations because Prisma cannot tell three links to the same
  /// table apart on its own.
  followUpsCreated  FollowUp[] @relation("FollowUpAuthor")
  followUpsAssigned FollowUp[] @relation("FollowUpAssignee")
  followUpsClosed   FollowUp[] @relation("FollowUpCompleter")

  @@index([active])
}

/// A chair. A two-chair practice can run two appointments at once, which the
/// schedule cannot express while every booking belongs to "the clinic".
model Operatory {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)

  createdAt DateTime @default(now())

  appointments Appointment[]

  @@index([active])
}

enum Role {
  /// Owner / dentist — everything, including staff and statistics.
  OWNER
  /// Assistant / nurse — clinical work, no business figures, no deletions.
  ASSISTANT
  /// Front desk — scheduling and contact details, no clinical record.
  RECEPTIONIST
  /// Locum or accountant — looks, changes nothing.
  READONLY
}

/// Append-only record of who changed what. Written by the action guard, never
/// edited, and readable only by the owner.
model AuditLog {
  id      String     @id @default(uuid())
  actorId String?
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Name and role are snapshotted so the trail still reads correctly after a
  /// person is renamed, demoted or removed.
  actorName String
  /// Null when the actor is not staff — a patient answering their own
  /// confirmation link has a name but no role in the practice.
  actorRole Role?

  action   String // create · update · delete · login · logout · denied
  entity   String // patient · appointment · visit · tooth · stock · service · staff · session
  entityId String?
  summary  String // already composed for display

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([actorId])
  /// Serves the view de-duplication, which asks what one person looked at in the
  /// last half hour — `actorId` on its own answers that by reading everything
  /// they have ever done.
  @@index([actorId, createdAt])
}

model Patient {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  phone        String
  email        String?
  dateOfBirth  DateTime?
  medicalNotes String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments  Appointment[]
  visitRecords  VisitRecord[]
  teethRecords  ToothRecord[]
  waitlist      WaitlistEntry[]
  plans         TreatmentPlan[]
  documents     PatientDocument[]
  prescriptions Prescription[]

  contacts      Contact[]
  alerts        PatientAlert[]
  works         Work[]
  followUps     FollowUp[]

  /// Whether they have agreed to be messaged. Deliberately tri-state: `null`
  /// means nobody has asked yet, which is a different thing from "no" and is
  /// the honest state of every record that predates the question.
  contactConsent   Boolean?
  preferredChannel ContactChannel?
  /// Which language to write to them in. Falls back to the app's default —
  /// without it, reminders go out in whichever language the *receptionist*
  /// happens to be using.
  locale String?

  /// A minor's phone number belongs to their parent, and the consent form has
  /// to be signed by them. Without these a child's record is either wrong or
  /// quietly holds an adult's details in the patient's own fields.
  guardianName  String?
  guardianPhone String?

  /// Needed by anything printed — a consent form, a referral letter, a recall
  /// card. `fiscalCode` is Italy's codice fiscale.
  address    String?
  fiscalCode String?

  emergencyContact String?

  /// "How did you hear about us" — the one CRM question an owner asks that the
  /// statistics page currently cannot answer at all.
  referralSource String?

  /// Recall: how often this patient should be seen. 0 disables recall for them.
  recallMonths Int @default(6)
  /// Set by "remind me later" so a declined patient stops resurfacing daily.
  recallSnoozedUntil DateTime?
  /// Stamped when the recall message is opened, so the list stops nagging.
  lastRecallAt       DateTime?

  /// Name, phone and email, lowercased with diacritics stripped.
  ///
  /// Written on save, never typed. The patient list searched with `ILIKE '%q%'`
  /// over four columns, which folds case but not accents — while the app's own
  /// `matches()` helper folds both, because typing *cesh* has to find *Çështje*.
  /// So the same query behaved differently depending on which box it was typed
  /// into, and Albanian names are exactly where it mattered. One folded column,
  /// one comparison, indexable.
  searchKey String @default("")

  /// Retired from the lists, not erased — the rule staff and materials already
  /// live under, finally applied to the record that has the most history hanging
  /// off it and the longest legal retention period.
  ///
  /// Set by two different acts. Archiving is the ordinary one: somebody who has
  /// moved away stops cluttering the list and keeps their chart. Merging is the
  /// other — the losing side of a duplicate is emptied of its history first (see
  /// `mergePatients`), so what stays behind is a husk kept only so a stale link
  /// or a printed slip still resolves to something.
  ///
  /// True deletion stays, owner-only, for the one case archiving cannot answer:
  /// a request to actually be erased.
  archivedAt DateTime?

  /// Every patient list in the app orders by this pair, and nothing served it.
  @@index([lastName, firstName])
  /// Every list filters it out, so it leads the ordering index the lists use.
  @@index([archivedAt])
  @@index([searchKey])
  /// "A patient with this number already exists" needs to be a lookup, not a scan.
  @@index([phone])
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?

  /// The catalogue entry, and a snapshot of what it was called when booked.
  ///
  /// The name alone meant a service renamed in the catalogue left every slot in
  /// the diary still saying the old thing, with no way to tell that they were
  /// the same treatment. The id is what anything counting should group by; the
  /// name is what the row should print.
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String?

  createdAt DateTime @default(now())

  /// Set when the patient answers the confirmation link themselves. No token is
  /// stored — it is derived from the id, so a leaked row reveals no way in.
  confirmedAt DateTime?
  declinedAt  DateTime?

  /// When they actually walked in.
  ///
  /// `ARRIVED` said *that* somebody is waiting and never *since when*, which is
  /// the half the front desk needs: "who has been sitting longest" and "we are
  /// running twenty minutes behind" are the same question asked of this column,
  /// and neither could be answered from a status alone. Cleared when the slot
  /// leaves `ARRIVED` for anything other than being seen, so a mis-tap does not
  /// leave a waiting-room clock running on somebody who went home.
  arrivedAt DateTime?

  /// The run of appointments this one was booked as part of — an ortho check
  /// every six weeks, a perio maintenance course.
  ///
  /// A plain shared uuid rather than a `Series` table: nothing about the run is
  /// true that is not already true of each appointment in it, and a table would
  /// only hold a rule that the bookings themselves already express. What it buys
  /// is the thing a series actually needs — "this is 3 of 8, here are the rest" —
  /// which is one indexed lookup.
  seriesId String?

  /// Who is treating, and in which chair. Both optional: a practice with one
  /// dentist and one room never has to answer, and every appointment booked
  /// before this existed keeps working.
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  operatoryId String?
  operatory   Operatory? @relation(fields: [operatoryId], references: [id], onDelete: SetNull)

  /// Why it was called off, and by whom. Both null while it still stands.
  cancelReason String?
  cancelledBy  CancelledBy?

  /// The appointment this one replaces. Makes "moved three times" visible
  /// instead of leaving a trail of cancelled rows nobody connects.
  rescheduledFromId String?      @unique
  rescheduledFrom   Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("Reschedule")

  /// The plan step this appointment fulfils, when it came from a treatment plan.
  planStep TreatmentStep?
  contacts Contact[]

  /// The write-up of what actually happened in this slot. See
  /// `VisitRecord.appointment` for why the two were separate for so long, and
  /// why this is a list of at most one rather than a single row.
  visitRecords VisitRecord[]

  @@index([date])
  @@index([patientId])
  /// The conflict search filters on both at once.
  @@index([date, status])
  /// "The rest of this run" — asked of every appointment that belongs to one.
  @@index([seriesId])
}

/// A course of treatment that spans several visits. The point is that a
/// half-finished plan stays visible instead of being remembered by one person.
model TreatmentPlan {
  id        String            @id @default(uuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  status    TreatmentPlanStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  steps TreatmentStep[]

  @@index([patientId])
  @@index([status])
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model TreatmentStep {
  id     String        @id @default(uuid())
  planId String
  plan   TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Position in the sequence, 1-based. Gaps are fine; only the order matters.
  position    Int
  title       String
  toothNum    Int?
  notes       String?
  status      TreatmentStepStatus @default(PENDING)
  completedAt DateTime?

  /// Booking the step links it here, so "3 of 5 done" and the calendar agree.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([planId])
}

enum TreatmentStepStatus {
  PENDING
  DONE
  SKIPPED
}

/// X-rays, photos and signed forms. The bytes live on disk (see `src/lib/files.ts`);
/// this row is the index, and the only thing the backup export carries.
model PatientDocument {
  id        String       @id @default(uuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      DocumentKind @default(OTHER)
  fileName  String
  mimeType  String
  sizeBytes Int
  /// Opaque on-disk name. Never the original filename — that is user input.
  storageKey String  @unique
  toothNum   Int?
  notes      String?

  uploadedById String?
  uploadedBy   StaffUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([patientId])
}

enum DocumentKind {
  XRAY
  PHOTO
  CONSENT
  /// The two faces of an identity card, kept as documents rather than as two
  /// columns on `Patient`: they are files with a size, a type and an uploader,
  /// which is what `PatientDocument` already is. Held apart from `OTHER` only so
  /// the patient's own screen can show them as a card with two sides — a
  /// receptionist checking an ID should not be hunting through the file list.
  ID_FRONT
  ID_BACK
  OTHER
}

/// Reusable wording for the handful of things a dentist prescribes weekly.
model PrescriptionTemplate {
  id       String  @id @default(uuid())
  name     String
  category String?
  body     String

  prescriptions Prescription[]
  /// Which treatments this wording follows. See `PrescriptionTemplateService`.
  services PrescriptionTemplateService[]
}

/// Which treatments a piece of standard wording is written after.
///
/// The templates existed; nothing connected them to the work. So the dialog
/// offered every template the practice had ever saved, in one flat select, and
/// the dentist read the whole list after every extraction to find the two that
/// applied. This is the missing edge: an antibiotic template tied to *surgical
/// extraction* is offered the moment that treatment is recorded, and the rest of
/// the list stays out of the way underneath.
model PrescriptionTemplateService {
  templateId String
  template   PrescriptionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([templateId, serviceId])
  @@index([serviceId])
}

model Prescription {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  templateId String?
  template   PrescriptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// The final text as issued — a later template edit must not rewrite history.
  body String

  issuedById String?
  issuedBy   StaffUser? @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([patientId])
}

enum AppointmentStatus {
  SCHEDULED
  /// They are in the waiting room. The front desk's most-pressed button, and
  /// the only thing that turns the day list into a queue the dentist can work.
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Who called it off. `reliability.ts` scores patients on missed appointments;
/// without this, a slot the *clinic* cancelled counts against the patient.
enum CancelledBy {
  PATIENT
  CLINIC
}

model VisitRecord {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate DateTime @default(now())
  notes     String

  /// What was typed, as one line, exactly as it was worded on the day.
  ///
  /// **Display only.** This is the sentence a person wrote, and the follow-up
  /// message quotes it back to the patient; it is not the record of what was
  /// done. That is `services` below — the rows — because splitting this string
  /// on commas made a treatment whose name contains one into two treatments,
  /// and grouped the statistics page by typed text rather than by catalogue
  /// entry. Same relationship as `Prescription.body` to its template.
  servicesText String @map("services")

  createdAt DateTime @default(now())

  /// The slot this write-up belongs to, when it was a booked one.
  ///
  /// The two rows describe the same event from opposite ends — the appointment
  /// is what was promised, the visit is what was done — and nothing joined
  /// them. Everything that wanted both had to guess by patient and calendar
  /// day, which is wrong in exactly the case that matters: a patient booked
  /// twice in a day, where one slot is written up and the other silently counts
  /// as recorded too. It also left "what did this booking consume?"
  /// unanswerable, because materials hang off the visit and the plan step hangs
  /// off the appointment.
  ///
  /// Nullable because a walk-in has no slot and a no-show has no visit, and
  /// because rows written before this field existed have no link and will not
  /// grow one — the deploy runs `db push` and never a backfill.
  ///
  /// One write-up per slot is the rule, but it is **not** `@unique`, for the
  /// reason `StockCategory.name` is not: the deploy runs `prisma db push`
  /// without `--accept-data-loss` (see `docker/entrypoint.sh`), and that refuses
  /// to add a unique constraint at all — not just when the data would violate
  /// it — which takes the release down on boot. `saveVisit` is the gate
  /// instead: it only ever links a slot that has no write-up yet.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  services       VisitService[]
  toothRecords   ToothRecord[]
  stockMovements StockMovement[]

  /// Who recorded it — shown on the timeline, kept when the account is disabled.
  staffUserId String?
  staffUser   StaffUser? @relation("VisitRecorder", fields: [staffUserId], references: [id], onDelete: SetNull)

  /// Who actually did the treatment. Diverges from the recorder the moment an
  /// assistant writes up the dentist's work, which is most of the time.
  performedById String?
  performedBy   StaffUser? @relation("VisitPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitDate])
  /// "Has this slot been written up?" is asked of every completed appointment
  /// on the day sheet, and `saveVisit` asks it again for every candidate slot.
  @@index([appointmentId])
}

model ToothRecord {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// FDI notation — 11–48 permanent, 51–85 primary. See `src/lib/teeth.ts`.
  /// Was Universal 1–32; `prisma/migrate-teeth-fdi.ts` converts existing rows.
  toothNum  Int
  status    String // Healthy, Caries, Extracted, Crown, Root Canal, etc.
  /// Which surfaces, as letters from `TOOTH_SURFACES` — e.g. `"MOD"`. Null when
  /// the status is about the whole tooth (extracted, missing, implant).
  surfaces  String?
  notes     String?
  updatedAt DateTime @updatedAt

  /// The visit that put the tooth in this state, when it was recorded during
  /// one. Turns a snapshot into something a timeline can explain.
  visitRecordId String?
  visitRecord   VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)

  @@unique([patientId, toothNum])
}

/// Practice-wide preferences that are not opening hours. A single row — the id
/// is fixed so there can only ever be one.
model ClinicProfile {
  id             String        @id @default("clinic")
  name           String        @default("")
  toothNumbering ToothNumbering @default(FDI)

  /// ISO 4217 code the money on the stock page is written in. A practice buys
  /// in one currency, so this is a setting rather than a column on every price.
  currency String @default("ALL")

  updatedAt      DateTime      @updatedAt
}

enum ToothNumbering {
  /// 11–48 / 51–85. What Europe teaches.
  FDI
  /// 1–32 and A–T. What North America teaches.
  UNIVERSAL
}

model StockItem {
  id       String @id @default(uuid())
  name     String
  /// **Boxes.** Not pieces, not millilitres — boxes, as they stand on the shelf.
  ///
  /// The storage room is worked one package at a time: a box arrives and is put
  /// on a shelf, and later somebody opens it and it is gone. That is the whole
  /// of it, and it is the only count anybody in the practice can state without
  /// guessing. A half-used box is still a box on the shelf until it is thrown
  /// out, and asking how many gloves are left in it gets an invented number.
  quantity Int    @default(0)
  minLimit Int    @default(5)

  /// What the shelf used to be counted in, back when every material named its
  /// own unit — "fiola", "copë", "litra", "pcs".
  ///
  /// Dead. Nothing reads it and no form asks for it: the app counts boxes and
  /// says so, in one word, in one place (`BOX_UNIT` in `src/lib/units.ts`). Ten
  /// units meant ten different words on ten rows of one list, and a reader
  /// holding a carton had to translate each one back into "how many of these are
  /// on the shelf" — which was always the actual question.
  ///
  /// Kept only because the deploy cannot drop it: `db push` runs without
  /// `--accept-data-loss` (see `docker/entrypoint.sh`), so removing the column
  /// would halt the release rather than migrate it. New rows are written "box"
  /// for the day somebody wants the old wording back and finds it never left.
  unit String @default("box")

  updatedAt DateTime @updatedAt

  /// The product this is one variant of — the same box in a different shade,
  /// size or flavour. Null for a material that has no siblings, which is most of
  /// them.
  ///
  /// See `StockProduct`. A variant is a `StockItem` in its own right and not a
  /// column on the product, because each shade is bought, counted, scanned and
  /// run out of separately: A2 being empty says nothing about A3.
  productId String?
  product   StockProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Which variant this is, in the manufacturer's own wording — "A2", "Size M",
  /// "22G". Only the part that differs from its siblings: the shared half is the
  /// product's name, and repeating it here is what produced eight rows all
  /// starting with the same four words.
  variantName String?

  /// A photograph of this exact box, and what kind of image it is.
  ///
  /// The one field on this row that needs no reading. Materials are recognised
  /// off the shelf by the look of the packaging — a colour, a shape, a logo —
  /// and never by an article number, so a list of names is a list somebody has
  /// to decode before they can act on it. A variant without its own picture
  /// falls back to the product's, because three shades of one composite come in
  /// three identical boxes.
  ///
  /// The key is a filename under the private storage directory, exactly like a
  /// patient document — see `src/lib/files.ts`. The bytes are handed out only by
  /// `/api/stock/photo/[id]`, which checks the session first.
  photoKey  String?
  photoMime String?

  /// Which shelf this lives on. Null is a real answer — see `StockCategory`.
  categoryId String?
  category   StockCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// What `category` used to be: whatever anyone typed into a free-text box.
  ///
  /// Superseded by `categoryId`, and kept only because the deploy cannot drop
  /// it — `db push` runs without `--accept-data-loss`, so removing the column
  /// would halt the release rather than migrate it. `@map` keeps the database
  /// column exactly where it was, which is what lets the value survive the
  /// deploy at all: `getStockCategories` reads it once, turns each distinct
  /// spelling into a `StockCategory`, and clears it. Nothing writes it again.
  legacyCategory String? @map("category")

  /// The practice's own article number, as written on the shelf label.
  ///
  /// A uuid is the database's name for a row, not the clinic's name for a
  /// material — the storage room is already numbered, and staff read those
  /// numbers off boxes and order forms. Optional, because a practice that never
  /// numbered anything should not be made to invent them.
  ///
  /// Kept unique by `saveStockItem` rather than by a constraint: the deploy runs
  /// `prisma db push` *without* `--accept-data-loss` on purpose, and adding a
  /// unique index is exactly the change that stops it dead (see
  /// `docker/entrypoint.sh`). Two people typing the same number in the same
  /// second would slip through; the cost of that is a duplicate label somebody
  /// edits, against a deploy that will not start.
  code String?

  /// What one `unit` costs to buy — the last price actually paid.
  ///
  /// Set by hand, or overwritten by a delivery that records what it cost, so
  /// the figure ages with the invoices rather than with whoever last edited the
  /// material. Null means nobody has priced it, which is not the same as free:
  /// an unpriced material is left out of the valuation instead of counted as 0.
  unitPrice Decimal? @db.Decimal(12, 2)

  /// How many pieces were in one box — 100 gloves.
  ///
  /// Dead, like `unit`, and for a blunter reason: nobody could keep it true. It
  /// asked the practice to state a number the supplier changes without telling
  /// anyone, in return for printing the order form in pieces — an order nobody
  /// places in pieces. The shelf is boxes, the order is boxes, the ledger is
  /// boxes, and every screen now says so in the same word.
  ///
  /// Kept for the reason `unit` is: `db push` will not drop a column.
  packSize Int @default(1)

  /// How many boxes to buy once the minimum is reached.
  ///
  /// Bulk stock is bought the same amount every time, and an item nobody logs
  /// per-use has no consumption history to project from — asking the owner once
  /// beats guessing from a burn rate that is mostly noise. When set, this
  /// replaces the projection in `reorder.ts` entirely.
  orderQty Int?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Set when an order goes out, cleared when it arrives. Without it the
  /// reorder suggestion reappears every morning until the box physically
  /// turns up, which trains everyone to ignore the list.
  orderedAt  DateTime?
  expectedAt DateTime?

  /// Discontinued, not erased — the same rule staff already live under.
  ///
  /// The ledger is the asset; this row is only its label. Deleting a material
  /// the practice has stopped buying used to take every `StockMovement` that
  /// ever named it with it, so last quarter's usage figures changed
  /// retroactively and nothing said so. An archived item leaves every list and
  /// every picker, and its history stays exactly where it was.
  archivedAt DateTime?

  movements  StockMovement[]
  usedBy     ServiceMaterial[]
  batches    StockBatch[]
  barcodes   ProductBarcode[]
  followUps  FollowUp[]

  /// Both the duplicate check on save and searching the shelf by label.
  @@index([code])
}

/// A symbol printed on a product, and the material it names.
///
/// Its own table rather than a column on `StockItem`, because one material
/// wears several codes: the manufacturer's each-level GTIN, the carton-level
/// GTIN above it, an older EAN from before a repack, and whatever label the
/// practice sticks on a decanted container. All of them have to resolve to one
/// row on the shelf, and a single column could only ever hold the last one
/// somebody scanned.
///
/// This is the table that makes scanning possible at all. Everything else the
/// symbol carries — the lot number, the expiry — is already modelled by
/// `StockBatch`; the only thing missing was the sentence "this GTIN is that
/// box", and it is the one fact no supplier can tell us and every practice
/// knows.
model ProductBarcode {
  id String @id @default(uuid())

  /// What a scan is matched on, after normalisation: a GTIN-14 for anything
  /// GS1, otherwise the symbol's raw text. Normalised on the way in so a carton
  /// scanned off its EAN-13 and the same carton scanned off its GS1 DataMatrix
  /// find one row rather than two — see `normaliseGtin` in `src/lib/barcode.ts`.
  ///
  /// Unique, and here rather than enforced in the action the way `StockItem.code`
  /// is: the reason that one cannot have a constraint is that adding a unique
  /// index to a *populated* table stops `prisma db push` (see
  /// `docker/entrypoint.sh`). This table is new, so it ships empty and the
  /// constraint costs nothing. It also has to be a constraint: two rows claiming
  /// one code would make a scan ambiguous, which is the one thing a scanner
  /// must never be.
  code String @unique

  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// How many **boxes** one scan of this symbol is worth.
  ///
  /// A carton of ten boxes and a single box carry *different* GTINs, and
  /// scanning the carton has to add what the carton holds. Without this the only
  /// honest options were to refuse pack-level codes or to count a carton as one
  /// box. Left at 1 — the overwhelming case — one beep is one box, which is what
  /// makes the scanner usable without reading anything on screen.
  packQty Int @default(1)

  /// What this symbol is on, in the words the storage room uses — "carton of 10
  /// boxes", "single blister". Shown when a material has more than one code, so
  /// the list is readable by someone holding the box.
  label String?

  /// The scan this was linked from, kept verbatim. A code that turns out to have
  /// been linked to the wrong material is diagnosed from what the scanner
  /// actually emitted, not from what we made of it.
  rawSample String?

  createdAt DateTime @default(now())

  @@index([itemId])
}

/// One product the practice buys, which the shelf may hold in several variants.
///
/// A composite comes in eight shades, a glove in four sizes, a suture in three
/// gauges. Each is its own `StockItem` — separately bought, counted, scanned and
/// run out of — but they are one product to everybody who handles them: one
/// picture on the box, one supplier, one decision to reorder. Without a row to
/// say so, the storage room is eight rows beginning "Kompozit Filtek Z250 —",
/// the catalogue is unreadable, and the same photograph is uploaded eight times.
///
/// Optional, and created by typing: `saveStockItem` matches the product name
/// case-insensitively and makes the row if it is new, so nobody has to visit a
/// second screen before they can record a material. A material with no product
/// is a product of one and is listed exactly like any other.
///
/// `name` is deliberately **not** `@unique`, for the reason `StockCategory.name`
/// is not: the deploy runs `prisma db push`, which refuses to add a unique
/// constraint to a populated table and takes the release down with it.
model StockProduct {
  id   String @id @default(uuid())
  name String

  /// Who makes it — "3M", "Dentsply". Kept apart from the name so "Filtek Z250"
  /// stays the thing staff say out loud, and the brand is what tells two
  /// near-identical products apart on the catalogue.
  brand String?

  /// The picture every variant falls back to. See `StockItem.photoKey`: three
  /// shades of one composite arrive in three identical boxes, so the photograph
  /// belongs to the product and a variant overrides it only when it genuinely
  /// looks different.
  photoKey  String?
  photoMime String?

  createdAt DateTime @default(now())

  items StockItem[]
}

/// A shelf in the storage room, named once and then picked from.
///
/// This was free text on every material, which meant "Higjienë", "higjiene" and
/// "Higjena" were three different shelves as far as the filter, the stocktake
/// grouping and the search were concerned — and nothing on screen ever said so.
/// A named row is a closed list: the category picker offers what the practice
/// decided, and a rename fixes every material at once instead of none of them.
///
/// `name` is deliberately **not** `@unique`, for the reason `StockItem.code`
/// is not: the deploy runs `prisma db push`, which refuses to add a unique
/// constraint and takes the release down with it. `saveStockCategory` is the
/// gate instead, and it compares case-insensitively — which a unique index
/// would not have done anyway.
model StockCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  items StockItem[]
}

/// Who the practice buys from. Enough to place the order, nothing more — there
/// is no purchasing or invoicing in this app by design.
model Supplier {
  id    String  @id @default(uuid())
  name  String
  phone String?
  email String?
  notes String?

  createdAt DateTime @default(now())

  items StockItem[]
}

/// A delivered lot of a material.
///
/// `StockItem.quantity` stays the authoritative count — these rows are *not* a
/// second ledger to reconcile against it. They exist for the two questions the
/// counter cannot answer: when does what we are holding expire, and which lot
/// number was used, which is the one a recall notice asks for.
model StockBatch {
  id     String    @id @default(uuid())
  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  lotNumber  String?
  expiryDate DateTime?
  /// How many arrived in this lot. Never changes — it is what the delivery note
  /// said, and rewriting it would lose the only figure that can be checked
  /// against the supplier.
  quantity Int @default(0)

  /// How many of them have since been used.
  ///
  /// The lots recorded what arrived and nothing ever drew them down, so "which
  /// lot number went into this patient" — the question a recall notice asks, and
  /// the stated reason these rows exist — stayed unanswerable. Consumption now
  /// allocates oldest-expiry-first, which is also the order a shelf should be
  /// worked, and `StockMovement.batchId` records where each one went.
  usedQuantity Int @default(0)

  /// When the delivery was actually bought, which is not when somebody got
  /// round to typing it in. `createdAt` is the keystroke; this is the invoice.
  /// Without it a lot entered a fortnight late lands in the wrong week and
  /// drags the 90-day burn rate in `reorder.ts` with it.
  purchasedAt DateTime?

  /// Printed on the box beside the expiry date. Two lots of the same material
  /// with the same expiry are told apart by this and nothing else, and a recall
  /// notice is as likely to name a manufacturing run as a lot number.
  manufacturedAt DateTime?

  /// What one unit of *this* lot cost. Prices move between deliveries, and the
  /// figure on `StockItem` is only ever the latest one — this is the record of
  /// what was really paid, which is the number an invoice can be checked
  /// against months later.
  unitPrice Decimal? @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())

  movements StockMovement[]

  @@index([itemId, expiryDate])
}

/// Append-only log of quantity changes — powers the "stock usage" analytics chart
/// and gives the dentist a plain audit trail of what was consumed and when.
model StockMovement {
  id     String    @id @default(uuid())
  itemId String
  /// `Restrict`, not `Cascade`: the ledger outlives the label. See
  /// `StockItem.archivedAt` — a discontinued material is archived, and the
  /// database refuses the delete that would rewrite history behind it.
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  delta     Int // negative = used / removed, positive = restocked
  reason    String? // e.g. "manual", "restock", "used in visit"
  createdAt DateTime @default(now())

  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  /// The visit that consumed it, when a visit did.
  ///
  /// `reason` said "used in visit" and nothing more, which made "why did we burn
  /// 40 syringes in March?" unanswerable and left a mis-recorded visit's
  /// deductions impossible to find, let alone reverse.
  visitRecordId String?
  visitRecord   VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)

  /// Which lot this came out of, when the material is tracked by lot. A
  /// consumption spanning two lots writes one movement per lot, so the trace
  /// stays exact rather than averaged.
  batchId String?
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([batchId])
  /// `reorder.ts` groups a date window by item. `itemId` leads, so this also
  /// serves the plain "movements for this material" lookup.
  @@index([itemId, createdAt])
}

/// A heading in the treatment catalogue — a department, or one subdivision of a
/// department.
///
/// A category typed per service becomes three spellings of itself, and the
/// catalogue is grouped by it on five different screens — so it is a row the
/// practice names once and every treatment picks from. Unlike a storage-room
/// shelf, a price list has two levels, not one — "Kirurgji" is a department,
/// "Implantologji" is a part of it, and flattening the two would either lose the
/// distinction or turn every heading into "Kirurgji — Implantologji".
///
/// Exactly two levels. `parentId` is null for a department and set for a
/// subcategory, and `saveServiceCategory` refuses a parent that already has one
/// — a third level has nowhere to be printed.
model ServiceCategory {
  id   String @id @default(uuid())
  name String

  parentId String?
  parent   ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ServiceCategory[] @relation("ServiceCategoryTree")

  createdAt DateTime @default(now())

  services Service[]

  @@index([parentId])
}

model Service {
  id          String @id @default(uuid())
  name        String
  durationMin Int    @default(30)

  /// Where this sits in the catalogue: a department, or a subcategory inside
  /// one. Null is a real answer — an unfiled treatment is still a treatment.
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// What `category` used to be: whatever anyone typed into a free-text box.
  ///
  /// Superseded by `categoryId`, and kept only because the deploy cannot drop
  /// it — `db push` runs without `--accept-data-loss`, so removing the column
  /// would halt the release rather than migrate it. `@map` keeps the database
  /// column exactly where it was, which is what lets the value survive the
  /// deploy at all: `getServiceCategories` reads it once, turns each distinct
  /// spelling into a top-level `ServiceCategory`, and clears it. Nothing writes
  /// it again.
  legacyCategory String? @map("category")

  /// Retired — see `ServiceMaterial`. Declared because Prisma requires both
  /// sides of a relation, not because anything reads it.
  materials    ServiceMaterial[]
  visits       VisitService[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  /// Standard prescription wording written after this treatment.
  prescriptionTemplates PrescriptionTemplateService[]

  @@index([categoryId])
}

/// One treatment performed at one visit.
///
/// The single most consequential thing the schema did not have. Three columns
/// named a service as free text — `Appointment.serviceName`,
/// `VisitRecord.services`, `WaitlistEntry.serviceName` — and the worst of them
/// was the visit's, because it was a *comma-separated list* in one column. A
/// service called "Filling, composite" silently became two. Renaming a service
/// split its own history into two bars on the statistics page. And nothing could
/// answer "which visits used this material", because the only link from a visit
/// to the catalogue was a string somebody typed.
///
/// The name is snapshotted anyway, for the same reason a prescription keeps its
/// own text: renaming a service must not rewrite what a visit says was done.
model VisitService {
  id      String      @id @default(uuid())
  visitId String
  visit   VisitRecord @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// The catalogue entry, when the treatment matched one. Null for anything
  /// typed by hand — which is exactly why stock deduction has always been
  /// driven by ids rather than by the text.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// What it was called on the day.
  name String

  /// Position in the line as it was typed, so the display order survives.
  position Int @default(1)

  @@index([visitId])
  @@index([serviceId])
}

/// Retired. Nothing in the application reads or writes this table.
///
/// It was the bill of materials for a treatment: set once per service, and
/// recording a visit deducted it. Consumption is now recorded by scanning the
/// product itself (see `ProductBarcode`), which is both more accurate — the
/// actual box, its actual lot — and honest about the case a bill of materials
/// could never handle, where a treatment used two anaesthetic carpules instead
/// of the one the catalogue predicted.
///
/// Still declared only because the deploy runs `prisma db push` *without*
/// `--accept-data-loss` (see `docker/entrypoint.sh`): removing a model whose
/// table holds rows is exactly the change that stops the release dead. The same
/// reason `Service.legacyCategory` is still here.
///
/// To be rid of it: run `tsx prisma/drop-service-materials.ts` once against the
/// live database, which empties the table, then delete this model and the two
/// relation fields that name it (`Service.materials`, `StockItem.usedBy`). With
/// no rows to lose, the next `db push` drops it without complaint.
model ServiceMaterial {
  id        String    @id @default(uuid())
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemId    String
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int       @default(1)

  @@unique([serviceId, itemId])
  @@index([serviceId])
}

/// A contraindication, as data rather than as a sentence in a paragraph.
///
/// `medical.ts` scans free-text notes for "allerg" and shouts when it finds it.
/// As a safety net over history that is already prose, that stays. As the *only*
/// representation of "allergic to penicillin" it is not enough: a heuristic over
/// wording cannot be cross-checked against a prescription, cannot be shown on
/// the day list before the patient sits down, and quietly misses a note that
/// says "reacts badly to amoxicillin".
model PatientAlert {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  kind MedicalAlertKind
  /// The drug or material itself, for the kinds where naming it is the point.
  /// Matched against prescription text, so it is stored as typed.
  substance String?
  severity  AlertSeverity @default(IMPORTANT)
  notes     String?

  createdById String?
  createdBy   StaffUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([patientId])
}

enum MedicalAlertKind {
  ALLERGY
  ANTICOAGULANT
  PREGNANCY
  DIABETES
  CARDIAC_PROPHYLAXIS
  LATEX
  PACEMAKER
  BISPHOSPHONATE
  OTHER
}

enum AlertSeverity {
  /// Stop and check before treating.
  CRITICAL
  /// Changes the plan; must be read.
  IMPORTANT
  /// Worth knowing.
  INFO
}

/// Every time somebody was actually contacted.
///
/// The app never sends anything itself — it opens WhatsApp or the mail client
/// with the text ready. That is a deliberate choice and it stays, but it left
/// the practice with no memory at all: no way to see that a patient was already
/// reminded this morning, no way to tell "asked once" from "asked three times
/// and heard nothing", and no answer when somebody says nobody told them.
model Contact {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// The appointment it was about, when it was about one.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  channel ContactChannel
  purpose ContactPurpose

  /// What was actually put in front of the patient, snapshotted — a later edit
  /// to the message template must not rewrite what was said last March.
  body String

  actorId String?
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([appointmentId])
}

enum ContactChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
}

enum ContactPurpose {
  REMINDER
  RECALL
  CONFIRMATION
  FOLLOW_UP
  OTHER
}

/// When the practice is open, one row per weekday. Kept as seven fixed rows
/// rather than a free list of intervals: a dentist thinks "Tuesday, 8 to 6, shut
/// for lunch", and every screen that lays out a day needs exactly that answer.
///
/// Times are the clinic's own wall clock (`CLINIC_TIME_ZONE`), not UTC — the
/// practice opens at eight local, whatever the server thinks the hour is.
model ClinicHours {
  /// 0 = Sunday … 6 = Saturday, matching `Date#getUTCDay()`.
  weekday Int @id

  /// A closed weekday keeps its times, so reopening on Saturdays does not mean
  /// retyping them.
  open      Boolean @default(true)
  openTime  String  @default("08:00")
  closeTime String  @default("20:00")

  /// The midday break, when there is one. Both null means straight through.
  breakStart String?
  breakEnd   String?

  updatedAt DateTime @updatedAt
}

/// A day or run of days when the practice is shut — a public holiday, the August
/// shutdown, a course. Separate from `ClinicHours` because it is an exception to
/// the pattern rather than a change of pattern.
model Closure {
  id String @id @default(uuid())

  /// Both UTC midnight, both inclusive: a single day has `from == to`.
  from   DateTime
  to     DateTime
  reason String

  /// Null means the whole practice is shut. Set, it is one person's leave — the
  /// others still work, and only that dentist's slots disappear.
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([from, to])
}

/// Patients who want an earlier slot. When an appointment is cancelled the app
/// offers the freed slot to whoever on this list actually fits it.
model WaitlistEntry {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Same pair as `Appointment`: the catalogue entry, plus what it was called.
  /// The duration was copied rather than looked up, so a service whose length
  /// was corrected left every waiting person still asking for the old one.
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String?

  durationMin Int @default(30)
  note        String?
  urgent      Boolean @default(false)

  createdAt  DateTime  @default(now())
  /// Set when the person is booked or the request is dropped.
  resolvedAt DateTime?

  @@index([resolvedAt])
  /// Booking somebody resolves their open entry, which looks them up by person.
  @@index([patientId])
}

/// One line of the works ledger — the register the practice keeps of everything
/// that goes out to a laboratory and comes back.
///
/// This is deliberately a *register* rather than a workflow: one wide row per
/// case, kept the way the practice already keeps it on paper, and exportable to
/// a spreadsheet in one click. The columns are the ones a clinic reads across
/// when the lab rings — their serial, our number for the patient, the name, a
/// phone to call back on, the diagnosis — and then the work itself, which is
/// never one thing and so is a list of rows rather than a column (`WorkLine`).
model Work {
  id String @id @default(uuid())

  /// Our own number for the row: 1 for the first, then up by one.
  ///
  /// A serial the database keeps, not the patient's `id` — that is a uuid, which
  /// is the right name for a row and the wrong thing to read down a phone. Gaps
  /// are possible if a row is deleted and are left as gaps: renumbering would
  /// change what a slip already sent to the lab refers to.
  number Int @unique @default(autoincrement())

  /// The laboratory's own serial for the case, as printed on their docket.
  /// Optional: it usually arrives after the case does.
  labSerial String?

  /// Who the work is for, when they are on the register. Optional, because a
  /// case can be logged for somebody whose record has not been made yet, and
  /// because the ledger must outlive a deleted patient (`SetNull`).
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  /// The name and number as written on the slip.
  ///
  /// Snapshotted, like `Appointment.serviceName` and for the same reason: this
  /// row is a copy of a docket that has already left the building. Correcting a
  /// patient's phone number today must not silently rewrite what the lab was
  /// given in March. The link above is what "show me this patient" follows.
  patientName String
  phone       String

  /// The span, in the shorthand the practice already writes: `3 x 4 x 7`, `5 x 7`.
  ///
  /// Called the diagnosis because that is the column's name on the paper
  /// register, but what goes in it is which teeth the work bridges. Free text and
  /// staying that way — the notation is the dentist's, not the app's, and a form
  /// that rejects how somebody has written it for twenty years is a form that
  /// gets worked around.
  diagnosis String?
  notes     String?

  /// The day the case went to the laboratory, at UTC midnight.
  ///
  /// Not `createdAt`, for the reason `StockBatch.purchasedAt` is not: `createdAt`
  /// is the keystroke, and a docket typed up on Monday for an impression that
  /// went out on Friday lands in the wrong month. The month is the unit this
  /// register is read and billed in, so the date has to be the one that is true.
  ///
  /// The default is for the deploy, not for the app — `saveWork` always sets
  /// this. Without one, `db push` refuses to add a required column to a table
  /// that already has rows and takes the release down on boot (see
  /// `docker/entrypoint.sh`); with one, a row written before the column existed
  /// simply lands on the day of the deploy.
  sentAt DateTime @default(now())

  /// The day the laboratory promised it back, at UTC midnight.
  ///
  /// The one date the paper register never had a column for, and the one the
  /// practice is actually asked about: "is my crown back yet" is a question
  /// about this, not about `sentAt`. Optional, because plenty of cases go out
  /// without a promise attached and inventing one would make every such row
  /// look late.
  dueAt DateTime?

  /// The day it came back. Null while the case is still out.
  ///
  /// What closes a row. Without it every case that ever passed its `dueAt`
  /// stays overdue for ever, so the register would fill with red and stop
  /// meaning anything — which is the failure mode of every to-do list that
  /// cannot be ticked off.
  receivedAt DateTime?

  /// Chase this one first.
  ///
  /// Deliberately a flag rather than a scale: a three-level priority invites an
  /// argument about whether something is high or medium, and a register where
  /// everything is high is a register with no priority at all. Same shape, and
  /// the same reasoning, as `WaitlistEntry.urgent`.
  urgent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     WorkLine[]
  followUps FollowUp[]

  /// The register is read a month at a time, newest first, and searched by the
  /// laboratory's serial.
  @@index([sentAt])
  @@index([patientId])
  @@index([labSerial])
  /// "What is late" reads the open cases by promised date, so both columns are
  /// in the index the question is asked of.
  @@index([receivedAt, dueAt])
}

/// One piece of work inside a case: which teeth, what is being made, and by whom.
///
/// A case is hardly ever one thing — a bridge on 14–16 and a crown on 24 go to
/// the same lab on the same impression — so this cannot be three more columns on
/// `Work` without either capping the case at one item or repeating the patient
/// down five rows. Same shape as `TreatmentStep` under `TreatmentPlan`.
model WorkLine {
  id     String @id @default(uuid())
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  /// Position in the case as it was written, so the display order survives.
  position Int @default(1)

  /// **How many** elements went to the laboratory for this piece of work.
  ///
  /// A count, not a list of teeth — which teeth is what `Work.diagnosis` already
  /// says (`3 x 4 x 7`). This is the number the laboratory bills on, and the
  /// whole reason a practice keeps its own register: the invoice at the end of
  /// the month says how many elements were made, and this is the only copy of
  /// how many were actually sent. Everything that sums — the case, the month,
  /// the export — sums this column.
  elements Int @default(1)

  /// Which teeth this piece of work covers, FDI, in the order the chart reads:
  /// `17,16x,15`. An `x` is a position the laboratory makes an element for and
  /// the mouth has no tooth in — the gap under a bridge.
  ///
  /// This is the `Diagnoza` column of the paper register, which the app used to
  /// keep as free text on `Work` (see `Work.diagnosis`) — one span for a case
  /// that routinely has three pieces of work in it, believed exactly as typed,
  /// readable by nobody. Here it belongs to the line, the way it does on the
  /// docket, and `elements` above falls out of it rather than being typed twice.
  ///
  /// Optional, because plenty of work names no teeth at all: a full denture, a
  /// repair, a bite splint.
  teeth String?

  /// What is being made — a crown, a bridge, a denture, a repair.
  ///
  /// The *name*, not a link to `WorkProcedure`, for the reason `patientName` is
  /// a copy and not a lookup: this row is a record of a docket that has already
  /// left the building, and renaming an entry in the catalogue two years later
  /// must not rewrite what was sent in March. The catalogue is where the form
  /// gets its options; this is what was chosen.
  procedure String

  /// Which laboratory. Free text rather than a row of its own: this is a
  /// register of what happened, and a practice sends to two or three labs whose
  /// names it already knows how to spell.
  lab String?

  @@index([workId])
}

/// The kinds of work this practice sends out, named once.
///
/// `WorkLine.procedure` was a text box, and a text box asked the same question
/// on every line of every case: a *zirconia crown* was going out as "Kurorë
/// zirkoni", "kurore zirkon" and "Zirkon" in the same week. Nothing could be
/// counted, and the register's whole job is counting.
///
/// So the same shape as `StockCategory` and `ServiceCategory`: a short list the
/// practice keeps, and a form that offers that list and nothing else. Flat, with
/// no parent — a laboratory bills for a crown or a denture, and there is nothing
/// underneath either of them worth filing.
model WorkProcedure {
  id   String @id @default(uuid())
  name String

  createdAt DateTime @default(now())
}

/// How loudly a follow-up asks. Two values on purpose, like `Work.urgent`: a
/// five-level scale is an invitation to file everything at the top, and a board
/// where every line is urgent is a board with no priority on it at all.
enum FollowUpPriority {
  NORMAL
  URGENT
}

/// Something the practice has to come back to, with a day attached.
///
/// The gap this fills is narrow and real. Everything else in the app is a record
/// of what *happened* — a slot, a visit, a case, a box off the shelf — and the
/// only things that ever chased anybody were derived: a recall falls out of the
/// last visit date, a low-stock warning out of a count. None of that can hold
/// "ring the lab about Berisha's bridge on Thursday", so it lived on a sticky
/// note on the monitor, which is the system this replaces.
///
/// Deliberately *not* called a reminder. That word is taken twice over — a
/// `Contact` of purpose `REMINDER` is the message a patient gets before their
/// appointment, and `/recalls` is the list of people due back. Both are about
/// contacting a patient; this is the practice talking to itself, and giving all
/// three the same name on screen would make the bell unreadable.
///
/// The link is three optional foreign keys rather than the `entity`/`entityId`
/// pair `AuditLog` uses, because these are live rows rather than a historical
/// record: a follow-up wants to *open* the thing it is about, and it should stop
/// existing when that thing does. Cascade gives both; a loose string gives a
/// button that leads to a 404.
model FollowUp {
  id String @id @default(uuid())

  /// What to do, in one line — the words that appear in the bell.
  title String
  notes String?

  /// The day it comes up, at UTC midnight.
  ///
  /// Required, and the whole point. A follow-up with no date is a note, and the
  /// app already has somewhere to write notes on every record worth writing them
  /// on; what nothing could do was make one surface again on a chosen morning.
  dueAt DateTime

  priority FollowUpPriority @default(NORMAL)

  /// Ticked off, and by whom. Kept rather than deleted so the board can be
  /// looked back over, and so a line closed by mistake can be reopened.
  doneAt   DateTime?
  doneById String?
  doneBy   StaffUser? @relation("FollowUpCompleter", fields: [doneById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   StaffUser? @relation("FollowUpAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Whose job it is. Null means the practice's rather than a person's, which is
  /// the honest default in a clinic of four people who all answer the phone.
  assignedToId String?
  assignedTo   StaffUser? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// What it is about. At most one of these is ever set — the form offers the
  /// record it was opened from — and all three may be null, because "order more
  /// gloves" is a real follow-up that is about nothing in particular.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: Cascade)

  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The bell's own query: what is still open, soonest first. `doneAt` leads
  /// because filtering the closed lines away is the first thing every read does.
  @@index([doneAt, dueAt])
  @@index([assignedToId])
  @@index([patientId])
  @@index([workId])
  @@index([stockItemId])
}
