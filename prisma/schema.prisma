// DentOrganizer — dental practice organizer & CRM
// No billing / payment / fiscalization models by design.

// Prisma 7 moved the connection URL out of the schema — see `prisma.config.ts`,
// which reads DATABASE_URL from `.env`.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// Who may do what. One row per person who touches the app; there is no
/// self-service signup — the owner creates every account from the Staff page.
model StaffUser {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  role      Role    @default(RECEPTIONIST)
  /// scrypt digest of the PIN, hex. Never the PIN itself.
  pinHash   String
  pinSalt   String
  /// Deactivating keeps the audit trail intact; deleting a person would not.
  active    Boolean @default(true)

  /// Brute-force guard for a 4–6 digit secret: lock the account, not the device.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  /// When this person last shut the reminder board.
  ///
  /// The board grew from two piles to seven, and the badge stopped ever reading
  /// nought: on a real practice sixteen of its twenty-one items had been sitting
  /// for days, because a booking request nobody has answered and a shelf below
  /// its minimum do not go away by themselves. A number that says the same thing
  /// every morning is one people stop reading, which is the exact failure the
  /// board was built to avoid — so it has to be able to say what is *new*.
  ///
  /// On the person, not in a cookie. "Since you last looked" is a fact about a
  /// reader, and this practice shares machines: a cookie would tell whoever sat
  /// down next that they had already seen it, and would forget every time
  /// somebody opened the app on their phone instead.
  ///
  /// Written when the board is **closed**, not when it is opened. Marking on
  /// open would clear the marks in the same breath as drawing them — the modal
  /// stays open across a server action and re-renders — so the new lines would
  /// vanish while somebody was still working through them.
  ///
  /// Null until the first time, and null means *nothing is new* rather than
  /// everything: a board that greeted a new member of staff by flagging all
  /// twenty-one rows as fresh would be lying about all twenty-one.
  boardSeenAt DateTime?

  /// What makes a calendar subscription link revocable.
  ///
  /// The feed token is an HMAC over this person's id — no stored row, nothing to
  /// clean up, which is the whole appeal (see `src/lib/calendar-feed.ts`). It was
  /// therefore also permanent: a subscription URL sits in a phone's settings for
  /// years, and if that phone was lost the only remedy was rotating
  /// `AUTH_SECRET`, which signs out every member of staff and invalidates every
  /// outstanding confirmation link at the same time.
  ///
  /// Signing this number into the token buys per-person revocation for one
  /// column: bump it, and every link ever issued for this dentist stops
  /// resolving, while everybody else's keeps working. The default is what lets
  /// it land on a table that already has rows.
  calendarFeedVersion Int @default(1)

  /// Which parts of the menu this person has switched off, as dot-joined keys.
  ///
  /// A preference and not an authorisation — see `src/lib/nav-visibility.ts`. It
  /// lives on the account rather than in a cookie because it is a fact about the
  /// *person*: the same nurse signs in at the surgery screen and at the front
  /// desk, and "I never open the works register" is true at both. That is the
  /// line the appearance settings fall on the other side of — a bright waiting
  /// room and a dim surgery genuinely want different themes, so those stay on
  /// the machine (see `Appearance`), and this does not.
  ///
  /// Empty is the honest default and means nothing is hidden. No backfill.
  hiddenNav String @default("")

  /// When this person was first shown where the help is, or null if never.
  ///
  /// A date rather than a boolean, because the useful question later is not
  /// *whether* somebody has been told but *when* — a pointer worth showing again
  /// after a year of new screens is a decision that needs the date to make.
  helpSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntries    AuditLog[]
  visitRecords    VisitRecord[]        @relation("VisitRecorder")
  visitsPerformed VisitRecord[]        @relation("VisitPerformer")
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  documents       PatientDocument[]
  prescriptions   Prescription[]
  appointments    Appointment[]
  leave           Closure[]
  contacts        Contact[]
  followUpFiles   FollowUpAttachment[]
  messagesSent    ScheduledMessage[]
  emailsSent      EmailMessage[]
  alertsCreated   PatientAlert[]

  /// Three roles on one board: who wrote the line, whose job it is, who ticked
  /// it off. Named relations because Prisma cannot tell three links to the same
  /// table apart on its own.
  followUpsCreated     FollowUp[]            @relation("FollowUpAuthor")
  followUpsAssigned    FollowUp[]            @relation("FollowUpAssignee")
  followUpsClosed      FollowUp[]            @relation("FollowUpCompleter")
  stockAlertsDismissed StockAlertDismissal[]

  /// Requests off the public page that this person picked up. See
  /// `AppointmentRequest`.
  requestsHandled AppointmentRequest[] @relation("AppointmentRequestHandler")

  @@index([active])
}

/// A chair. A two-chair practice can run two appointments at once, which the
/// schedule cannot express while every booking belongs to "the clinic".
model Operatory {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)

  createdAt DateTime @default(now())

  appointments Appointment[]

  @@index([active])
}

enum Role {
  /// Owner / dentist — everything, including staff and statistics.
  OWNER
  /// Assistant / nurse — clinical work, no business figures, no deletions.
  ASSISTANT
  /// Front desk — scheduling and contact details, no clinical record.
  RECEPTIONIST
  /// Locum or accountant — looks, changes nothing.
  READONLY
}

/// Append-only record of who changed what. Written by the action guard, never
/// edited, and readable only by the owner.
model AuditLog {
  id        String     @id @default(uuid())
  actorId   String?
  actor     StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Name and role are snapshotted so the trail still reads correctly after a
  /// person is renamed, demoted or removed.
  actorName String
  /// Null when the actor is not staff — a patient answering their own
  /// confirmation link has a name but no role in the practice.
  actorRole Role?

  action   String // create · update · delete · login · logout · denied
  entity   String // patient · appointment · visit · tooth · stock · service · staff · session
  entityId String?
  summary  String // already composed for display

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([actorId])
  /// Serves the view de-duplication, which asks what one person looked at in the
  /// last half hour — `actorId` on its own answers that by reading everything
  /// they have ever done.
  @@index([actorId, createdAt])
  /// The activity page's own query: one kind of record, newest first, over a
  /// span of dates. `entity` alone answered the filter and then left the sort to
  /// read every matching row — fine against a table trimmed to a few thousand,
  /// and this one is never trimmed (see `src/lib/audit-retention.ts`), so the
  /// sort is what would have decayed as the practice used the app.
  @@index([entity, createdAt])
  /// "Everything that ever happened to *this* record", which is the question a
  /// disputed chart actually asks. The column has been written since the trail
  /// existed and nothing could filter on it, so the page could only offer
  /// "every patient" where somebody needed one.
  ///
  /// `entityId` leads rather than `entity`, because the patient view matches a
  /// list of ids across several kinds at once — an appointment, a visit and the
  /// chart all belong to one person — and a composite led by `entity` could not
  /// serve that with one scan.
  @@index([entityId, createdAt])
}

model Patient {
  id            String            @id @default(uuid())
  firstName     String
  lastName      String
  phone         String
  email         String?
  dateOfBirth   DateTime?
  medicalNotes  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  appointments  Appointment[]
  visitRecords  VisitRecord[]
  teethRecords  ToothRecord[]
  perioExams    PerioExam[]
  waitlist      WaitlistEntry[]
  plans         TreatmentPlan[]
  documents     PatientDocument[]
  prescriptions Prescription[]

  contacts          Contact[]
  scheduledMessages ScheduledMessage[]
  emailThreads      EmailThread[]
  alerts            PatientAlert[]
  works             Work[]
  followUps         FollowUp[]

  /// Whether they have agreed to be messaged. Deliberately tri-state: `null`
  /// means nobody has asked yet, which is a different thing from "no" and is
  /// the honest state of every record that predates the question.
  contactConsent   Boolean?
  preferredChannel ContactChannel?
  /// Which language to write to them in. Falls back to the app's default —
  /// without it, reminders go out in whichever language the *receptionist*
  /// happens to be using.
  locale           String?

  /// A minor's phone number belongs to their parent, and the consent form has
  /// to be signed by them. Without these a child's record is either wrong or
  /// quietly holds an adult's details in the patient's own fields.
  guardianName  String?
  guardianPhone String?

  /// Needed by anything printed — a consent form, a referral letter, a recall
  /// card. `fiscalCode` is Italy's codice fiscale.
  address    String?
  fiscalCode String?

  emergencyContact String?

  /// "How did you hear about us" — the one CRM question an owner asks that the
  /// statistics page currently cannot answer at all.
  referralSource String?

  /// Recall: how often this patient should be seen. 0 disables recall for them.
  recallMonths       Int       @default(6)
  /// Set by "remind me later" so a declined patient stops resurfacing daily.
  recallSnoozedUntil DateTime?
  /// Stamped when the recall message is opened, so the list stops nagging.
  lastRecallAt       DateTime?

  /// Name, phone and email, lowercased with diacritics stripped.
  ///
  /// Written on save, never typed. The patient list searched with `ILIKE '%q%'`
  /// over four columns, which folds case but not accents — while the app's own
  /// `matches()` helper folds both, because typing *cesh* has to find *Çështje*.
  /// So the same query behaved differently depending on which box it was typed
  /// into, and Albanian names are exactly where it mattered. One folded column,
  /// one comparison, indexable.
  searchKey String @default("")

  /// Retired from the lists, not erased — the rule staff and materials already
  /// live under, finally applied to the record that has the most history hanging
  /// off it and the longest legal retention period.
  ///
  /// Set by two different acts. Archiving is the ordinary one: somebody who has
  /// moved away stops cluttering the list and keeps their chart. Merging is the
  /// other — the losing side of a duplicate is emptied of its history first (see
  /// `mergePatients`), so what stays behind is a husk kept only so a stale link
  /// or a printed slip still resolves to something.
  ///
  /// True deletion stays, owner-only, for the one case archiving cannot answer:
  /// a request to actually be erased.
  archivedAt DateTime?

  /// Every patient list in the app orders by this pair, and nothing served it.
  @@index([lastName, firstName])
  /// Every list filters it out, so it leads the ordering index the lists use.
  @@index([archivedAt])
  @@index([searchKey])
  /// "A patient with this number already exists" needs to be a lookup, not a scan.
  @@index([phone])
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?

  /// The catalogue entry, and a snapshot of what it was called when booked.
  ///
  /// The name alone meant a service renamed in the catalogue left every slot in
  /// the diary still saying the old thing, with no way to tell that they were
  /// the same treatment. The id is what anything counting should group by; the
  /// name is what the row should print.
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String?

  createdAt DateTime @default(now())

  /// Set when the patient answers the confirmation link themselves. No token is
  /// stored — it is derived from the id, so a leaked row reveals no way in.
  confirmedAt DateTime?
  declinedAt  DateTime?

  /// When they actually walked in.
  ///
  /// `ARRIVED` said *that* somebody is waiting and never *since when*, which is
  /// the half the front desk needs: "who has been sitting longest" and "we are
  /// running twenty minutes behind" are the same question asked of this column,
  /// and neither could be answered from a status alone. Cleared when the slot
  /// leaves `ARRIVED` for anything other than being seen, so a mis-tap does not
  /// leave a waiting-room clock running on somebody who went home.
  arrivedAt DateTime?

  /// The run of appointments this one was booked as part of — an ortho check
  /// every six weeks, a perio maintenance course.
  ///
  /// A plain shared uuid rather than a `Series` table: nothing about the run is
  /// true that is not already true of each appointment in it, and a table would
  /// only hold a rule that the bookings themselves already express. What it buys
  /// is the thing a series actually needs — "this is 3 of 8, here are the rest" —
  /// which is one indexed lookup.
  seriesId String?

  /// Who is treating, and in which chair. Both optional: a practice with one
  /// dentist and one room never has to answer, and every appointment booked
  /// before this existed keeps working.
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  operatoryId String?
  operatory   Operatory? @relation(fields: [operatoryId], references: [id], onDelete: SetNull)

  /// Why it was called off, and by whom. Both null while it still stands.
  cancelReason String?
  cancelledBy  CancelledBy?

  /// The appointment this one replaces. Makes "moved three times" visible
  /// instead of leaving a trail of cancelled rows nobody connects.
  rescheduledFromId String?      @unique
  rescheduledFrom   Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("Reschedule")

  /// The plan step this appointment fulfils, when it came from a treatment plan.
  planStep TreatmentStep?
  contacts Contact[]

  scheduledMessages ScheduledMessage[]
  /// The write-up of what actually happened in this slot. See
  /// `VisitRecord.appointment` for why the two were separate for so long.
  ///
  /// A list of at most one, and the "at most" is now the database's word rather
  /// than an intention: `VisitRecord.appointmentId` carries a unique index. Kept
  /// as a list rather than narrowed to `VisitRecord?` because every read of it
  /// is an existence test — `visitRecords: { none: {} }`, `_count` — which says
  /// what it means in the list form, and converting would be a wide, purely
  /// cosmetic edit across queries that already behave correctly.
  visitRecords      VisitRecord[]

  @@index([date])
  @@index([patientId])
  /// The conflict search filters on both at once.
  @@index([date, status])
  /// "The rest of this run" — asked of every appointment that belongs to one.
  @@index([seriesId])
  /// Postgres does not index a foreign key on its own, and all three of these
  /// are `SetNull`: retiring a service, a dentist or a chair makes the database
  /// look for every appointment naming it, which without these is a sequential
  /// scan of the diary — the one table here that grows for the life of the
  /// practice and is never pruned.
  @@index([serviceId])
  @@index([staffUserId])
  @@index([operatoryId])
}

/// A course of treatment that spans several visits. The point is that a
/// half-finished plan stays visible instead of being remembered by one person.
model TreatmentPlan {
  id        String              @id @default(uuid())
  patientId String
  patient   Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  status    TreatmentPlanStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  /// When somebody last chased this course of treatment, and the day they said
  /// they would chase it again.
  ///
  /// Stalled is derived — sixty quiet days and nothing booked — and it had
  /// exactly two exits: do the work, or cancel the plan. Neither is what
  /// actually happens when a patient is rung and says "after the summer", so
  /// the list was worked by ticking off treatment nobody gave. `followUpOn`
  /// is the third exit and the honest one: the plan stays open, stops
  /// shouting, and comes back on the day it was promised for. See
  /// `summarisePlan`.
  lastContactedAt DateTime?
  followUpOn      DateTime?

  steps TreatmentStep[]

  @@index([patientId])
  @@index([status])
  /// The stalled tab reads this to find the plans whose promised day has come.
  @@index([followUpOn])
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model TreatmentStep {
  id          String              @id @default(uuid())
  planId      String
  plan        TreatmentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Position in the sequence, 1-based. Gaps are fine; only the order matters.
  position    Int
  title       String
  toothNum    Int?
  notes       String?
  status      TreatmentStepStatus @default(PENDING)
  completedAt DateTime?

  /// The catalogue entry this step plans, when it came from one.
  ///
  /// The title alone is a snapshot of what somebody tapped, and it stays the
  /// thing the row prints — renaming a treatment must not rewrite a plan
  /// written months ago, for the same reason `Appointment.serviceName` is kept
  /// beside `Appointment.serviceId`. What the id buys is the half a string
  /// cannot answer: how long to leave in the diary when this step is booked,
  /// and which planned treatments were actually delivered.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// Booking the step links it here, so "3 of 5 done" and the calendar agree.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([serviceId])
}

enum TreatmentStepStatus {
  PENDING
  DONE
  SKIPPED
}

/// X-rays, photos and signed forms. The bytes live on disk (see `src/lib/files.ts`);
/// this row is the index, and the only thing the backup export carries.
model PatientDocument {
  id         String       @id @default(uuid())
  patientId  String
  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind       DocumentKind @default(OTHER)
  fileName   String
  mimeType   String
  sizeBytes  Int
  /// Opaque on-disk name. Never the original filename — that is user input.
  storageKey String       @unique
  toothNum   Int?
  notes      String?

  uploadedById String?
  uploadedBy   StaffUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([patientId])
}

enum DocumentKind {
  XRAY
  PHOTO
  CONSENT
  /// The two faces of an identity card, kept as documents rather than as two
  /// columns on `Patient`: they are files with a size, a type and an uploader,
  /// which is what `PatientDocument` already is. Held apart from `OTHER` only so
  /// the patient's own screen can show them as a card with two sides — a
  /// receptionist checking an ID should not be hunting through the file list.
  ID_FRONT
  ID_BACK
  OTHER
}

/// Reusable wording for the handful of things a dentist prescribes weekly.
model PrescriptionTemplate {
  id       String  @id @default(uuid())
  name     String
  category String?
  body     String

  prescriptions Prescription[]
  /// Which treatments this wording follows. See `PrescriptionTemplateService`.
  services      PrescriptionTemplateService[]
}

/// Which treatments a piece of standard wording is written after.
///
/// The templates existed; nothing connected them to the work. So the dialog
/// offered every template the practice had ever saved, in one flat select, and
/// the dentist read the whole list after every extraction to find the two that
/// applied. This is the missing edge: an antibiotic template tied to *surgical
/// extraction* is offered the moment that treatment is recorded, and the rest of
/// the list stays out of the way underneath.
model PrescriptionTemplateService {
  templateId String
  template   PrescriptionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([templateId, serviceId])
  @@index([serviceId])
}

model Prescription {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  templateId String?
  template   PrescriptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// The final text as issued — a later template edit must not rewrite history.
  body String

  issuedById String?
  issuedBy   StaffUser? @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([patientId])
  /// `SetNull`, and `deletePrescriptionTemplate` is a real action — so deleting
  /// a piece of standard wording searched every prescription ever issued.
  ///
  /// The staff columns on this table and the others like it are deliberately
  /// left unindexed: an account is deactivated, never deleted (see
  /// `StaffUser.active`), so nothing ever asks the question those would answer.
  @@index([templateId])
}

enum AppointmentStatus {
  SCHEDULED
  /// They are in the waiting room. The front desk's most-pressed button, and
  /// the only thing that turns the day list into a queue the dentist can work.
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Who called it off. `reliability.ts` scores patients on missed appointments;
/// without this, a slot the *clinic* cancelled counts against the patient.
enum CancelledBy {
  PATIENT
  CLINIC
}

model VisitRecord {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate DateTime @default(now())
  notes     String

  /// What was typed, as one line, exactly as it was worded on the day.
  ///
  /// **Display only.** This is the sentence a person wrote, and the follow-up
  /// message quotes it back to the patient; it is not the record of what was
  /// done. That is `services` below — the rows — because splitting this string
  /// on commas made a treatment whose name contains one into two treatments,
  /// and grouped the statistics page by typed text rather than by catalogue
  /// entry. Same relationship as `Prescription.body` to its template.
  servicesText String @map("services")

  createdAt DateTime @default(now())

  /// The slot this write-up belongs to, when it was a booked one.
  ///
  /// The two rows describe the same event from opposite ends — the appointment
  /// is what was promised, the visit is what was done — and nothing joined
  /// them. Everything that wanted both had to guess by patient and calendar
  /// day, which is wrong in exactly the case that matters: a patient booked
  /// twice in a day, where one slot is written up and the other silently counts
  /// as recorded too. It also left "what did this booking consume?"
  /// unanswerable, because materials hang off the visit and the plan step hangs
  /// off the appointment.
  ///
  /// Nullable because a walk-in has no slot and a no-show has no visit, and
  /// because rows written before this field existed have no link and never grew
  /// one.
  ///
  /// One write-up per slot, and now enforced rather than merely intended. This
  /// was prose for as long as the deploy ran `prisma db push`, which refuses to
  /// add a unique constraint at all — not just when the data would violate it —
  /// and would have taken the release down on boot. The deploy replays
  /// `prisma/migrations` now, so the rule is a rule; see
  /// `20260820110000_constraints_the_deploy_can_now_carry`, which unlinks the
  /// later of any two write-ups claiming one slot before adding the index.
  ///
  /// `saveVisit` still checks first, because a constraint violation surfaces as
  /// a database error and "this slot is already written up" is a sentence
  /// somebody at the desk can act on.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  services       VisitService[]
  toothRecords   ToothRecord[]
  perioExams     PerioExam[]
  stockMovements StockMovement[]

  /// Who recorded it — shown on the timeline, kept when the account is disabled.
  staffUserId String?
  staffUser   StaffUser? @relation("VisitRecorder", fields: [staffUserId], references: [id], onDelete: SetNull)

  /// Who actually did the treatment. Diverges from the recorder the moment an
  /// assistant writes up the dentist's work, which is most of the time.
  performedById String?
  performedBy   StaffUser? @relation("VisitPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitDate])
  /// "Has this slot been written up?" is asked of every completed appointment
  /// on the day sheet, and `saveVisit` asks it again for every candidate slot.
  @@index([appointmentId])
}

/// One periodontal reading of one tooth, kept forever.
///
/// `ToothRecord` holds a tooth's *current* state and is unique on
/// `[patientId, toothNum]`, so every save overwrites the last one. For the
/// condition half that is defensible — a filled tooth is filled, and the audit
/// trail carries who changed it and when. For the periodontal half it destroys
/// the reading.
///
/// A pocket depth is only diagnostic against its own history. 5mm that was 3mm
/// last year is disease progressing and gets referred; 5mm that has been 5mm
/// for three years is a stable defect that gets maintained. The practice was
/// taking the measurement and throwing away the comparison, which is most of
/// what the measurement is for.
///
/// So every perio save appends here as well as updating the snapshot. Two
/// consequences worth stating:
///
///   - The newest row for a tooth **mirrors** `ToothRecord`. That duplication is
///     deliberate: it makes this table answer "chart this tooth's pockets over
///     time" on its own, without joining to a snapshot that is about to change.
///   - There is no notion of an examination *session*. A tooth probed today and
///     its neighbour probed tomorrow are two rows with two timestamps, which is
///     what actually happened. The clinical question is always per tooth.
model PerioExam {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNum  Int

  /// When the reading was taken. Defaulted rather than passed, because a
  /// history whose timestamps the caller can choose is not a history.
  recordedAt DateTime @default(now())

  /// The same four encodings `ToothRecord` documents, copied verbatim so a row
  /// here can be read without reference to the snapshot it came from.
  pockets   String?
  bleeding  String?
  recession String?
  mobility  Int?
  furcation Int?

  /// The visit it was taken during, when it was taken during one.
  visitRecordId String?
  visitRecord   VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)

  /// "This tooth's readings, newest first" — the only question asked of this
  /// table, and asked once per tooth on every perio view.
  @@index([patientId, toothNum, recordedAt])
  @@index([visitRecordId])
}

model ToothRecord {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// FDI notation — 11–48 permanent, 51–85 primary. See `src/lib/teeth.ts`.
  /// Was Universal 1–32; `prisma/migrate-teeth-fdi.ts` converts existing rows.
  toothNum  Int
  status    String // Healthy, Caries, Extracted, Crown, Root Canal, etc.
  /// Which surfaces, as letters from `TOOTH_SURFACES` — e.g. `"MOD"`. Null when
  /// the status is about the whole tooth (extracted, missing, implant).
  surfaces  String?
  notes     String?
  updatedAt DateTime @updatedAt

  /// Miller mobility grade, 0–3. Null is "nobody has pressed it", which is not
  /// the same fact as 0 — an unassessed tooth must not be reported as firm.
  mobility Int?

  /// Probing depths in millimetres at the six standard sites, comma-separated
  /// in the order `PERIO_SITES` declares: DB, B, MB round the cheek side, then
  /// DL, L, ML round the tongue side. An empty slot is a site not probed, so
  /// `"3,2,,4,3,2"` is five readings and not a 0.
  ///
  /// One column rather than a row per site: six readings are taken together, in
  /// one pass, and are only ever read together. See `src/lib/perio.ts`.
  pockets String?

  /// Which of those six sites bled on probing, as six characters of `1` and
  /// `0`. Bleeding is what turns a 4mm pocket from a measurement into a
  /// diagnosis, so it is recorded per site alongside the depth or not at all.
  bleeding String?

  /// Gingival recession in millimetres at the same six sites, same encoding and
  /// same "empty means not measured" rule as `pockets`.
  ///
  /// Without it a pocket depth cannot be turned into clinical attachment loss,
  /// and CAL is the measure periodontal diagnosis actually runs on: a 4mm
  /// pocket on a gum that has receded 3mm is 7mm of lost attachment and a very
  /// different tooth from a 4mm pocket with no recession. Recorded separately
  /// rather than folded into the depth because they are two different probe
  /// readings taken from two different landmarks.
  recession String?

  /// Furcation involvement where the roots divide, as a grade 0–3, or null on a
  /// tooth that has no furcation to involve — every single-rooted tooth in the
  /// mouth. One grade per tooth rather than one per furcation: the worst of them
  /// is what decides whether a molar is restorable, which is the question this
  /// column exists to answer.
  furcation Int?

  /// The visit that put the tooth in this state, when it was recorded during
  /// one. Turns a snapshot into something a timeline can explain.
  visitRecordId String?
  visitRecord   VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)

  @@unique([patientId, toothNum])
  /// `SetNull` on the visit, so deleting one looks for every tooth it charted.
  @@index([visitRecordId])
}

/// Practice-wide preferences that are not opening hours. A single row — the id
/// is fixed so there can only ever be one.
model ClinicProfile {
  id             String         @id @default("clinic")
  name           String         @default("")
  toothNumbering ToothNumbering @default(FDI)

  /// ISO 4217 code the money on the stock page is written in. A practice buys
  /// in one currency, so this is a setting rather than a column on every price.
  currency String @default("ALL")

  /// The letterhead: how the practice identifies itself on paper it hands out.
  ///
  /// Every printed sheet in the app — a prescription, a treatment plan, a lab
  /// docket — is a document that leaves the building, and until now each one
  /// headed itself with the practice's *name* and nothing else. The pads this
  /// clinic actually uses carry a phone number and an email under the mark,
  /// because the whole point of the header is that whoever is holding the paper
  /// can get back in touch without having to already know how.
  ///
  /// Three separate columns rather than one free-text block: the lab docket
  /// wants the phone and not the address, the prescription wants both, and a
  /// blob would force every sheet to print all of it or parse it apart.
  ///
  /// All optional, and every sheet omits what is blank. A practice that has not
  /// filled these in gets the header it has today rather than a line of empty
  /// separators.
  phone   String?
  email   String?
  address String?

  updatedAt DateTime @updatedAt
}

enum ToothNumbering {
  /// 11–48 / 51–85. What Europe teaches.
  FDI
  /// 1–32 and A–T. What North America teaches.
  UNIVERSAL
}

model StockItem {
  id       String @id @default(uuid())
  name     String
  /// **Boxes.** Not pieces, not millilitres — boxes, as they stand on the shelf.
  ///
  /// The storage room is worked one package at a time: a box arrives and is put
  /// on a shelf, and later somebody opens it and it is gone. That is the whole
  /// of it, and it is the only count anybody in the practice can state without
  /// guessing. A half-used box is still a box on the shelf until it is thrown
  /// out, and asking how many gloves are left in it gets an invented number.
  quantity Int    @default(0)
  minLimit Int    @default(5)

  /// What the shelf used to be counted in, back when every material named its
  /// own unit — "fiola", "copë", "litra", "pcs".
  ///
  /// Dead. Nothing reads it and no form asks for it: the app counts boxes and
  /// says so, in one word, in one place (`BOX_UNIT` in `src/lib/units.ts`). Ten
  /// units meant ten different words on ten rows of one list, and a reader
  /// holding a carton had to translate each one back into "how many of these are
  /// on the shelf" — which was always the actual question.
  ///
  /// Kept because dropping a populated column is a decision, not a tidy-up —
  /// no longer because the deploy cannot carry it, which was the reason while it
  /// ran `db push`. A migration could drop this in reviewed SQL whenever the
  /// practice is sure. New rows are written "box" in the meantime, for the day
  /// somebody wants the old wording back and finds it never left.
  unit String @default("box")

  updatedAt DateTime @updatedAt

  /// The product this is one variant of — the same box in a different shade,
  /// size or flavour. Null for a material that has no siblings, which is most of
  /// them.
  ///
  /// See `StockProduct`. A variant is a `StockItem` in its own right and not a
  /// column on the product, because each shade is bought, counted, scanned and
  /// run out of separately: A2 being empty says nothing about A3.
  productId String?
  product   StockProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Which variant this is, in the manufacturer's own wording — "A2", "Size M",
  /// "22G". Only the part that differs from its siblings: the shared half is the
  /// product's name, and repeating it here is what produced eight rows all
  /// starting with the same four words.
  variantName String?

  /// A photograph of this exact box, and what kind of image it is.
  ///
  /// The one field on this row that needs no reading. Materials are recognised
  /// off the shelf by the look of the packaging — a colour, a shape, a logo —
  /// and never by an article number, so a list of names is a list somebody has
  /// to decode before they can act on it. A variant without its own picture
  /// falls back to the product's, because three shades of one composite come in
  /// three identical boxes.
  ///
  /// The key is a filename under the private storage directory, exactly like a
  /// patient document — see `src/lib/files.ts`. The bytes are handed out only by
  /// `/api/stock/photo/[id]`, which checks the session first.
  photoKey  String?
  photoMime String?

  /// Which shelf this lives on. Null is a real answer — see `StockCategory`.
  categoryId String?
  category   StockCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// What `category` used to be: whatever anyone typed into a free-text box.
  ///
  /// Superseded by `categoryId`. `@map` keeps the database column exactly where
  /// it was, which is what let the value survive the rename at all:
  /// `getStockCategories` reads it once, turns each distinct spelling into a
  /// `StockCategory`, and clears it. Nothing writes it again.
  ///
  /// Kept now only until somebody confirms every practice has been through that
  /// adoption pass — the deploy replays migrations, so dropping it is a
  /// migration away rather than impossible.
  legacyCategory String? @map("category")

  /// The practice's own article number, as written on the shelf label.
  ///
  /// A uuid is the database's name for a row, not the clinic's name for a
  /// material — the storage room is already numbered, and staff read those
  /// numbers off boxes and order forms. Optional, because a practice that never
  /// numbered anything should not be made to invent them.
  ///
  /// Unique, at last. `saveStockItem` checked for a duplicate and said so in a
  /// sentence, but the check had a race in it — two people typing the same
  /// number in the same second both passed — and it could not be closed while
  /// the deploy ran `prisma db push`, which refuses to add a unique index and
  /// takes the release with it.
  ///
  /// Postgres permits any number of NULLs in a unique index, which is what makes
  /// this compatible with the column staying optional. `saveStockItem` keeps its
  /// check: it is what turns a collision into a readable refusal instead of a
  /// database error.
  code String? @unique

  /// Where the box physically is — "Cupboard 2, top shelf", "Surgery 1 drawer".
  ///
  /// Free text on purpose, unlike `category`. The two answer different
  /// questions and only one of them is a list: a category is a *kind* of thing
  /// and gets typed once per shelf, so a closed list is what stops three
  /// spellings of "Higjena". A location is a sentence about one cupboard in one
  /// building, it is read by a person walking to it, and forcing it through a
  /// managed list would mean maintaining a taxonomy of a room nobody else will
  /// ever see.
  ///
  /// Optional, and expected to stay empty in a practice small enough that every
  /// material has one obvious home. It earns its place the moment there are two
  /// rooms — which is exactly when "where do we keep the articaine" stops having
  /// an answer everybody already knows.
  location String?

  /// What one `unit` costs to buy — the last price actually paid.
  ///
  /// Set by hand, or overwritten by a delivery that records what it cost, so
  /// the figure ages with the invoices rather than with whoever last edited the
  /// material. Null means nobody has priced it, which is not the same as free:
  /// an unpriced material is left out of the valuation instead of counted as 0.
  unitPrice Decimal? @db.Decimal(12, 2)

  /// How many pieces were in one box — 100 gloves.
  ///
  /// Dead, like `unit`, and for a blunter reason: nobody could keep it true. It
  /// asked the practice to state a number the supplier changes without telling
  /// anyone, in return for printing the order form in pieces — an order nobody
  /// places in pieces. The shelf is boxes, the order is boxes, the ledger is
  /// boxes, and every screen now says so in the same word.
  ///
  /// Kept for the reason `unit` is: dropping a populated column is a decision
  /// nobody has made, rather than one the deploy cannot carry.
  packSize Int @default(1)

  /// How many boxes to buy once the minimum is reached.
  ///
  /// Bulk stock is bought the same amount every time, and an item nobody logs
  /// per-use has no consumption history to project from — asking the owner once
  /// beats guessing from a burn rate that is mostly noise. When set, this
  /// replaces the projection in `reorder.ts` entirely.
  orderQty Int?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Set when an order goes out, cleared when it arrives. Without it the
  /// reorder suggestion reappears every morning until the box physically
  /// turns up, which trains everyone to ignore the list.
  orderedAt  DateTime?
  expectedAt DateTime?

  /// Discontinued, not erased — the same rule staff already live under.
  ///
  /// The ledger is the asset; this row is only its label. Deleting a material
  /// the practice has stopped buying used to take every `StockMovement` that
  /// ever named it with it, so last quarter's usage figures changed
  /// retroactively and nothing said so. An archived item leaves every list and
  /// every picker, and its history stays exactly where it was.
  archivedAt DateTime?

  movements  StockMovement[]
  usedBy     ServiceMaterial[]
  batches    StockBatch[]
  barcodes   ProductBarcode[]
  followUps  FollowUp[]
  orderLines PurchaseOrderLine[]

  /// The one open "not now" against this material's low-stock alert, if any.
  /// See `StockAlertDismissal` — at most one per material, which is why this
  /// side is singular rather than a list.
  alertDismissal StockAlertDismissal?

  /// Both the duplicate check on save and searching the shelf by label.
  @@index([code])
  /// Filtered directly, not merely joined: the catalogue groups the shelf by
  /// product, the storage-room filter by category, the reorder list by supplier,
  /// and `singleVariantOf` asks for a product's variants on every scan.
  @@index([productId])
  @@index([categoryId])
  @@index([supplierId])
}

/// A symbol printed on a product, and the material it names.
///
/// Its own table rather than a column on `StockItem`, because one material
/// wears several codes: the manufacturer's each-level GTIN, the carton-level
/// GTIN above it, an older EAN from before a repack, and whatever label the
/// practice sticks on a decanted container. All of them have to resolve to one
/// row on the shelf, and a single column could only ever hold the last one
/// somebody scanned.
///
/// This is the table that makes scanning possible at all. Everything else the
/// symbol carries — the lot number, the expiry — is already modelled by
/// `StockBatch`; the only thing missing was the sentence "this GTIN is that
/// box", and it is the one fact no supplier can tell us and every practice
/// knows.
model ProductBarcode {
  id String @id @default(uuid())

  /// What a scan is matched on, after normalisation: a GTIN-14 for anything
  /// GS1, otherwise the symbol's raw text. Normalised on the way in so a carton
  /// scanned off its EAN-13 and the same carton scanned off its GS1 DataMatrix
  /// find one row rather than two — see `normaliseGtin` in `src/lib/barcode.ts`.
  ///
  /// Unique, and always was — this table shipped empty, so the constraint cost
  /// nothing even when `prisma db push` would not add one to a populated table.
  /// `StockItem.code` has caught up since the deploy started replaying
  /// migrations.
  ///
  /// It has to be a constraint either way: two rows claiming one code would make
  /// a scan ambiguous, which is the one thing a scanner must never be.
  code String @unique

  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// How many **boxes** one scan of this symbol is worth.
  ///
  /// A carton of ten boxes and a single box carry *different* GTINs, and
  /// scanning the carton has to add what the carton holds. Without this the only
  /// honest options were to refuse pack-level codes or to count a carton as one
  /// box. Left at 1 — the overwhelming case — one beep is one box, which is what
  /// makes the scanner usable without reading anything on screen.
  packQty Int @default(1)

  /// What this symbol is on, in the words the storage room uses — "carton of 10
  /// boxes", "single blister". Shown when a material has more than one code, so
  /// the list is readable by someone holding the box.
  label String?

  /// The scan this was linked from, kept verbatim. A code that turns out to have
  /// been linked to the wrong material is diagnosed from what the scanner
  /// actually emitted, not from what we made of it.
  rawSample String?

  createdAt DateTime @default(now())

  @@index([itemId])
}

/// One product the practice buys, which the shelf may hold in several variants.
///
/// A composite comes in eight shades, a glove in four sizes, a suture in three
/// gauges. Each is its own `StockItem` — separately bought, counted, scanned and
/// run out of — but they are one product to everybody who handles them: one
/// picture on the box, one supplier, one decision to reorder. Without a row to
/// say so, the storage room is eight rows beginning "Kompozit Filtek Z250 —",
/// the catalogue is unreadable, and the same photograph is uploaded eight times.
///
/// Optional, and created by typing: `saveStockItem` matches the product name
/// case-insensitively and makes the row if it is new, so nobody has to visit a
/// second screen before they can record a material. A material with no product
/// is a product of one and is listed exactly like any other.
///
/// `name` is deliberately **not** `@unique`, for the reason `StockCategory.name`
/// is not — and it is no longer the deploy's reason. `saveStockItem` matches
/// case-insensitively, and a plain unique index does not: it would let "Filtek
/// Z250" and "filtek z250" both exist while claiming to prevent exactly that,
/// which is worse than no constraint, because it reads like one.
model StockProduct {
  id   String @id @default(uuid())
  name String

  /// Who makes it — "3M", "Dentsply". Kept apart from the name so "Filtek Z250"
  /// stays the thing staff say out loud, and the brand is what tells two
  /// near-identical products apart on the catalogue.
  brand String?

  /// The picture every variant falls back to. See `StockItem.photoKey`: three
  /// shades of one composite arrive in three identical boxes, so the photograph
  /// belongs to the product and a variant overrides it only when it genuinely
  /// looks different.
  photoKey  String?
  photoMime String?

  createdAt DateTime @default(now())

  items StockItem[]
}

/// A shelf in the storage room, named once and then picked from.
///
/// This was free text on every material, which meant "Higjienë", "higjiene" and
/// "Higjena" were three different shelves as far as the filter, the stocktake
/// grouping and the search were concerned — and nothing on screen ever said so.
/// A named row is a closed list: the category picker offers what the practice
/// decided, and a rename fixes every material at once instead of none of them.
///
/// `name` is deliberately **not** `@unique`, and this is now the only reason
/// left: `saveStockCategory` compares case-insensitively, which a unique index
/// would not do. "Higjienë" and "higjienë" are one shelf to everybody except a
/// database index, so the index would wave through the exact duplicate the
/// check exists to stop.
///
/// `StockItem.code` gained its constraint once the deploy started replaying
/// migrations; this one stays in the action deliberately, not for want of a
/// migration. Postgres could express it as a unique index over `lower(name)`,
/// which Prisma cannot describe in this file — so the schema and the database
/// would disagree about what constraints exist, and the check would still be
/// needed for the readable refusal.
model StockCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  items StockItem[]
}

/// Who the practice buys from. Enough to place the order, nothing more — there
/// is no purchasing or invoicing in this app by design.
model Supplier {
  id    String  @id @default(uuid())
  name  String
  phone String?
  email String?
  notes String?

  createdAt DateTime @default(now())

  items  StockItem[]
  orders PurchaseOrder[]
}

/// An order that was actually placed, as a document rather than as a flag.
///
/// `StockItem.orderedAt` was the whole of purchasing: a timestamp meaning "this
/// one is on its way", set when the message went out and cleared when anything
/// at all arrived. It answers one question well and three not at all.
///
///  - **Ordered ten, received six.** The first box through the scanner cleared
///    the flag, the line left the reorder list, and the four that never came
///    were forgotten by every screen in the app at once. There was nowhere to
///    record a part-delivery because there was nowhere to record an amount.
///  - **What did we order?** The list existed for as long as it took to paste
///    into WhatsApp. `reorderAsText` built it, the message was sent, and nothing
///    kept a copy — so an invoice arriving three weeks later could not be
///    checked against the order it was answering.
///  - **What did we agree to pay?** Prices are recorded on arrival, which is
///    where a supplier's own figure goes unquestioned: the moment to notice a
///    rise is when it is quoted, not after it is paid.
///
/// Deliberately *not* automatic. A purchase is the owner's decision and stays
/// one — this is created by the same press that used to set the flag, and
/// nothing here orders anything by itself.
///
/// The flags on `StockItem` stay exactly where they are. Four screens read them
/// on every render — the reorder list, the storage page, the alert board and the
/// reminder centre — and re-deriving "is this on order" from a join in each of
/// them would be a slower answer to a question already answered. This is the
/// record; those are its index, and the actions here write both.
model PurchaseOrder {
  id String @id @default(uuid())

  /// Who it was sent to. Null for the group of materials nobody has said where
  /// to buy — which is a real order somebody placed by other means, not an
  /// error, so it is recorded rather than refused.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Snapshotted, for the reason a visit snapshots its treatment names: a
  /// supplier renamed or removed next year must not rewrite what this order says
  /// it was sent to.
  supplierName String @default("")

  placedAt   DateTime  @default(now())
  expectedAt DateTime?

  /// Set when nothing is outstanding — every line received, or the order given
  /// up on. A closed order is history; an open one is a question.
  closedAt DateTime?

  /// True when it was closed by hand rather than by the last box arriving. The
  /// two are different facts and a date alone cannot tell them apart.
  cancelled Boolean @default(false)

  notes String?

  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  lines PurchaseOrderLine[]

  /// The one query the orders screen makes: what is still open, newest first.
  @@index([closedAt, placedAt])
  @@index([supplierId])
}

/// One material on one order, and how much of it has turned up.
///
/// `receivedQuantity` against `quantity` is the whole reason this table exists:
/// it is the difference between "that order is done" and "four of the ten are
/// still owed to us", and it is the figure nothing in the app could hold.
model PurchaseOrderLine {
  id      String        @id @default(uuid())
  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Snapshotted like the supplier's, and for the same reason.
  itemName String @default("")

  /// Boxes asked for.
  quantity Int @default(1)

  /// Boxes arrived, across however many deliveries answered this line. Only
  /// ever increased, and never past `quantity` — a supplier sending twelve
  /// against an order of ten has closed the line and delivered two extra, which
  /// the shelf records and the order does not pretend to have asked for.
  receivedQuantity Int @default(0)

  /// Receiving looks for the oldest open line naming this material.
  @@index([itemId, receivedQuantity])
  @@index([orderId])
}

/// A delivered lot of a material.
///
/// `StockItem.quantity` stays the authoritative count — these rows are *not* a
/// second ledger to reconcile against it. They exist for the two questions the
/// counter cannot answer: when does what we are holding expire, and which lot
/// number was used, which is the one a recall notice asks for.
model StockBatch {
  id     String    @id @default(uuid())
  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  lotNumber  String?
  expiryDate DateTime?
  /// How many arrived in this lot. Never changes — it is what the delivery note
  /// said, and rewriting it would lose the only figure that can be checked
  /// against the supplier.
  quantity   Int       @default(0)

  /// How many of them have since been used.
  ///
  /// The lots recorded what arrived and nothing ever drew them down, so "which
  /// lot number went into this patient" — the question a recall notice asks, and
  /// the stated reason these rows exist — stayed unanswerable. Consumption now
  /// allocates oldest-expiry-first, which is also the order a shelf should be
  /// worked, and `StockMovement.batchId` records where each one went.
  usedQuantity Int @default(0)

  /// When the delivery was actually bought, which is not when somebody got
  /// round to typing it in. `createdAt` is the keystroke; this is the invoice.
  /// Without it a lot entered a fortnight late lands in the wrong week and
  /// drags the 90-day burn rate in `reorder.ts` with it.
  purchasedAt DateTime?

  /// Printed on the box beside the expiry date. Two lots of the same material
  /// with the same expiry are told apart by this and nothing else, and a recall
  /// notice is as likely to name a manufacturing run as a lot number.
  manufacturedAt DateTime?

  /// What one unit of *this* lot cost. Prices move between deliveries, and the
  /// figure on `StockItem` is only ever the latest one — this is the record of
  /// what was really paid, which is the number an invoice can be checked
  /// against months later.
  unitPrice Decimal? @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())

  movements StockMovement[]

  @@index([itemId, expiryDate])
}

/// Append-only log of quantity changes — powers the "stock usage" analytics chart
/// and gives the dentist a plain audit trail of what was consumed and when.
model StockMovement {
  id        String    @id @default(uuid())
  itemId    String
  /// `Restrict`, not `Cascade`: the ledger outlives the label. See
  /// `StockItem.archivedAt` — a discontinued material is archived, and the
  /// database refuses the delete that would rewrite history behind it.
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  delta     Int // negative = used / removed, positive = restocked
  reason    String? // e.g. "manual", "restock", "used in visit"
  createdAt DateTime  @default(now())

  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  /// The visit that consumed it, when a visit did.
  ///
  /// `reason` said "used in visit" and nothing more, which made "why did we burn
  /// 40 syringes in March?" unanswerable and left a mis-recorded visit's
  /// deductions impossible to find, let alone reverse.
  visitRecordId String?
  visitRecord   VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)

  /// Which lot this came out of, when the material is tracked by lot. A
  /// consumption spanning two lots writes one movement per lot, so the trace
  /// stays exact rather than averaged.
  batchId String?
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([batchId])
  /// `reorder.ts` groups a date window by item. `itemId` leads, so this also
  /// serves the plain "movements for this material" lookup.
  @@index([itemId, createdAt])
  /// The ledger is append-only and never pruned, which makes it the largest
  /// table in the database and the worst one to scan. Both of these are
  /// `SetNull`, so deleting a visit or an account did exactly that.
  @@index([visitRecordId])
  @@index([staffUserId])
}

/// A heading in the treatment catalogue — a department, or one subdivision of a
/// department.
///
/// A category typed per service becomes three spellings of itself, and the
/// catalogue is grouped by it on five different screens — so it is a row the
/// practice names once and every treatment picks from. Unlike a storage-room
/// shelf, a price list has two levels, not one — "Kirurgji" is a department,
/// "Implantologji" is a part of it, and flattening the two would either lose the
/// distinction or turn every heading into "Kirurgji — Implantologji".
///
/// Exactly two levels. `parentId` is null for a department and set for a
/// subcategory, and `saveServiceCategory` refuses a parent that already has one
/// — a third level has nowhere to be printed.
model ServiceCategory {
  id   String @id @default(uuid())
  name String

  parentId String?
  parent   ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ServiceCategory[] @relation("ServiceCategoryTree")

  createdAt DateTime @default(now())

  services Service[]

  @@index([parentId])
}

model Service {
  id          String @id @default(uuid())
  name        String
  durationMin Int    @default(30)

  /// Where this sits in the catalogue: a department, or a subcategory inside
  /// one. Null is a real answer — an unfiled treatment is still a treatment.
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// What `category` used to be: whatever anyone typed into a free-text box.
  ///
  /// Superseded by `categoryId`. `@map` keeps the database column exactly where
  /// it was, which is what let the value survive the rename at all:
  /// `getServiceCategories` reads it once, turns each distinct spelling into a
  /// top-level `ServiceCategory`, and clears it. Nothing writes it again.
  ///
  /// Kept now only until somebody confirms every practice has been through that
  /// adoption pass — the deploy replays migrations, so dropping it is a
  /// migration away rather than impossible.
  legacyCategory String? @map("category")

  /// Retired — see `ServiceMaterial`. Declared because Prisma requires both
  /// sides of a relation, not because anything reads it.
  materials             ServiceMaterial[]
  visits                VisitService[]
  appointments          Appointment[]
  waitlist              WaitlistEntry[]
  /// Steps that plan this treatment. Declared because Prisma requires both
  /// sides; the plan reads its own `serviceId`, never this list.
  planSteps             TreatmentStep[]
  /// Standard prescription wording written after this treatment.
  prescriptionTemplates PrescriptionTemplateService[]

  @@index([categoryId])
}

/// One treatment performed at one visit.
///
/// The single most consequential thing the schema did not have. Three columns
/// named a service as free text — `Appointment.serviceName`,
/// `VisitRecord.services`, `WaitlistEntry.serviceName` — and the worst of them
/// was the visit's, because it was a *comma-separated list* in one column. A
/// service called "Filling, composite" silently became two. Renaming a service
/// split its own history into two bars on the statistics page. And nothing could
/// answer "which visits used this material", because the only link from a visit
/// to the catalogue was a string somebody typed.
///
/// The name is snapshotted anyway, for the same reason a prescription keeps its
/// own text: renaming a service must not rewrite what a visit says was done.
model VisitService {
  id      String      @id @default(uuid())
  visitId String
  visit   VisitRecord @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// The catalogue entry, when the treatment matched one. Null for anything
  /// typed by hand — which is exactly why stock deduction has always been
  /// driven by ids rather than by the text.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// What it was called on the day.
  name String

  /// Position in the line as it was typed, so the display order survives.
  position Int @default(1)

  @@index([visitId])
  @@index([serviceId])
}

/// Retired. Nothing in the application reads or writes this table.
///
/// It was the bill of materials for a treatment: set once per service, and
/// recording a visit deducted it. Consumption is now recorded by scanning the
/// product itself (see `ProductBarcode`), which is both more accurate — the
/// actual box, its actual lot — and honest about the case a bill of materials
/// could never handle, where a treatment used two anaesthetic carpules instead
/// of the one the catalogue predicted.
///
/// Still declared because the table still holds rows, and dropping a populated
/// table is a decision rather than a tidy-up. It is no longer *blocked*, though:
/// the deploy replays migrations now, so a migration could empty and drop it in
/// reviewed SQL — which is what `prisma/drop-service-materials.ts` does by hand
/// today.
///
/// To be rid of it: fold that script into a migration, then delete this model
/// and the two relation fields that name it (`Service.materials`,
/// `StockItem.usedBy`). What is wanted before that is somebody deciding the
/// bills of materials are genuinely not coming back.
model ServiceMaterial {
  id        String    @id @default(uuid())
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemId    String
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int       @default(1)

  @@unique([serviceId, itemId])
  @@index([serviceId])
}

/// A contraindication, as data rather than as a sentence in a paragraph.
///
/// `medical.ts` scans free-text notes for "allerg" and shouts when it finds it.
/// As a safety net over history that is already prose, that stays. As the *only*
/// representation of "allergic to penicillin" it is not enough: a heuristic over
/// wording cannot be cross-checked against a prescription, cannot be shown on
/// the day list before the patient sits down, and quietly misses a note that
/// says "reacts badly to amoxicillin".
model PatientAlert {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  kind      MedicalAlertKind
  /// The drug or material itself, for the kinds where naming it is the point.
  /// Matched against prescription text, so it is stored as typed.
  substance String?
  severity  AlertSeverity    @default(IMPORTANT)
  notes     String?

  createdById String?
  createdBy   StaffUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([patientId])
}

enum MedicalAlertKind {
  ALLERGY
  ANTICOAGULANT
  PREGNANCY
  DIABETES
  CARDIAC_PROPHYLAXIS
  LATEX
  PACEMAKER
  BISPHOSPHONATE
  OTHER
}

enum AlertSeverity {
  /// Stop and check before treating.
  CRITICAL
  /// Changes the plan; must be read.
  IMPORTANT
  /// Worth knowing.
  INFO
}

/// Every time somebody was actually contacted.
///
/// The app never sends anything itself — it opens WhatsApp or the mail client
/// with the text ready. That is a deliberate choice and it stays, but it left
/// the practice with no memory at all: no way to see that a patient was already
/// reminded this morning, no way to tell "asked once" from "asked three times
/// and heard nothing", and no answer when somebody says nobody told them.
model Contact {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// The appointment it was about, when it was about one.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  channel ContactChannel
  purpose ContactPurpose

  /// What was actually put in front of the patient, snapshotted — a later edit
  /// to the message template must not rewrite what was said last March.
  body String

  actorId String?
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([appointmentId])
}

enum ContactChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
}

enum ContactPurpose {
  REMINDER
  RECALL
  CONFIRMATION
  FOLLOW_UP
  OTHER
}

/// When the practice is open, one row per weekday. Kept as seven fixed rows
/// rather than a free list of intervals: a dentist thinks "Tuesday, 8 to 6, shut
/// for lunch", and every screen that lays out a day needs exactly that answer.
///
/// Times are the clinic's own wall clock (`CLINIC_TIME_ZONE`), not UTC — the
/// practice opens at eight local, whatever the server thinks the hour is.
model ClinicHours {
  /// 0 = Sunday … 6 = Saturday, matching `Date#getUTCDay()`.
  weekday Int @id

  /// A closed weekday keeps its times, so reopening on Saturdays does not mean
  /// retyping them.
  open      Boolean @default(true)
  openTime  String  @default("08:00")
  closeTime String  @default("20:00")

  /// The midday break, when there is one. Both null means straight through.
  breakStart String?
  breakEnd   String?

  updatedAt DateTime @updatedAt
}

/// A day or run of days when the practice is shut — a public holiday, the August
/// shutdown, a course. Separate from `ClinicHours` because it is an exception to
/// the pattern rather than a change of pattern.
model Closure {
  id String @id @default(uuid())

  /// Both UTC midnight, both inclusive: a single day has `from == to`.
  from   DateTime
  to     DateTime
  reason String

  /// Null means the whole practice is shut. Set, it is one person's leave — the
  /// others still work, and only that dentist's slots disappear.
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([from, to])
}

/// Patients who want an earlier slot. When an appointment is cancelled the app
/// offers the freed slot to whoever on this list actually fits it.
model WaitlistEntry {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Same pair as `Appointment`: the catalogue entry, plus what it was called.
  /// The duration was copied rather than looked up, so a service whose length
  /// was corrected left every waiting person still asking for the old one.
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String?

  durationMin Int     @default(30)
  note        String?
  urgent      Boolean @default(false)

  createdAt  DateTime  @default(now())
  /// Set when the person is booked or the request is dropped.
  resolvedAt DateTime?

  @@index([resolvedAt])
  /// Booking somebody resolves their open entry, which looks them up by person.
  @@index([patientId])
  /// `SetNull`, and a treatment genuinely can be deleted from the catalogue —
  /// which without this looks for every waiting person who asked for it.
  @@index([serviceId])
}

/// One line of the works ledger — the register the practice keeps of everything
/// that goes out to a laboratory and comes back.
///
/// This is deliberately a *register* rather than a workflow: one wide row per
/// case, kept the way the practice already keeps it on paper, and exportable to
/// a spreadsheet in one click. The columns are the ones a clinic reads across
/// when the lab rings — their serial, our number for the patient, the name, a
/// phone to call back on, the diagnosis — and then the work itself, which is
/// never one thing and so is a list of rows rather than a column (`WorkLine`).
model Work {
  id String @id @default(uuid())

  /// Our own number for the row: 1 for the first, then up by one.
  ///
  /// A serial the database keeps, not the patient's `id` — that is a uuid, which
  /// is the right name for a row and the wrong thing to read down a phone. Gaps
  /// are possible if a row is deleted and are left as gaps: renumbering would
  /// change what a slip already sent to the lab refers to.
  number Int @unique @default(autoincrement())

  /// The laboratory's own serial for the case, as printed on their docket.
  /// Optional: it usually arrives after the case does.
  labSerial String?

  /// Who the work is for, when they are on the register. Optional, because a
  /// case can be logged for somebody whose record has not been made yet, and
  /// because the ledger must outlive a deleted patient (`SetNull`).
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  /// The name and number as written on the slip.
  ///
  /// Snapshotted, like `Appointment.serviceName` and for the same reason: this
  /// row is a copy of a docket that has already left the building. Correcting a
  /// patient's phone number today must not silently rewrite what the lab was
  /// given in March. The link above is what "show me this patient" follows.
  patientName String
  phone       String

  /// The span, in the shorthand the practice already writes: `3 x 4 x 7`, `5 x 7`.
  ///
  /// Called the diagnosis because that is the column's name on the paper
  /// register, but what goes in it is which teeth the work bridges. Free text and
  /// staying that way — the notation is the dentist's, not the app's, and a form
  /// that rejects how somebody has written it for twenty years is a form that
  /// gets worked around.
  diagnosis String?
  notes     String?

  /// The day the case went to the laboratory, at UTC midnight.
  ///
  /// Not `createdAt`, for the reason `StockBatch.purchasedAt` is not: `createdAt`
  /// is the keystroke, and a docket typed up on Monday for an impression that
  /// went out on Friday lands in the wrong month. The month is the unit this
  /// register is read and billed in, so the date has to be the one that is true.
  ///
  /// The default is for the deploy, not for the app — `saveWork` always sets
  /// this. A required column cannot be added to a table that already has rows
  /// without one, and with it a row written before the column existed simply
  /// lands on the day of the deploy.
  sentAt DateTime @default(now())

  /// The day the laboratory promised it back, at UTC midnight.
  ///
  /// The one date the paper register never had a column for, and the one the
  /// practice is actually asked about: "is my crown back yet" is a question
  /// about this, not about `sentAt`. Optional, because plenty of cases go out
  /// without a promise attached and inventing one would make every such row
  /// look late.
  dueAt DateTime?

  /// The day it came back. Null while the case is still out.
  ///
  /// What closes a row. Without it every case that ever passed its `dueAt`
  /// stays overdue for ever, so the register would fill with red and stop
  /// meaning anything — which is the failure mode of every to-do list that
  /// cannot be ticked off.
  receivedAt DateTime?

  /// Chase this one first.
  ///
  /// Deliberately a flag rather than a scale: a three-level priority invites an
  /// argument about whether something is high or medium, and a register where
  /// everything is high is a register with no priority at all. Same shape, and
  /// the same reasoning, as `WaitlistEntry.urgent`.
  urgent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     WorkLine[]
  followUps FollowUp[]

  /// The register is read a month at a time, newest first, and searched by the
  /// laboratory's serial.
  @@index([sentAt])
  @@index([patientId])
  @@index([labSerial])
  /// "What is late" reads the open cases by promised date, so both columns are
  /// in the index the question is asked of.
  @@index([receivedAt, dueAt])
}

/// One piece of work inside a case: which teeth, what is being made, and by whom.
///
/// A case is hardly ever one thing — a bridge on 14–16 and a crown on 24 go to
/// the same lab on the same impression — so this cannot be three more columns on
/// `Work` without either capping the case at one item or repeating the patient
/// down five rows. Same shape as `TreatmentStep` under `TreatmentPlan`.
model WorkLine {
  id     String @id @default(uuid())
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  /// Position in the case as it was written, so the display order survives.
  position Int @default(1)

  /// **How many** elements went to the laboratory for this piece of work.
  ///
  /// A count, not a list of teeth — which teeth is what `Work.diagnosis` already
  /// says (`3 x 4 x 7`). This is the number the laboratory bills on, and the
  /// whole reason a practice keeps its own register: the invoice at the end of
  /// the month says how many elements were made, and this is the only copy of
  /// how many were actually sent. Everything that sums — the case, the month,
  /// the export — sums this column.
  elements Int @default(1)

  /// Which teeth this piece of work covers, FDI, in the order the chart reads:
  /// `17,16x,15`. An `x` is a position the laboratory makes an element for and
  /// the mouth has no tooth in — the gap under a bridge.
  ///
  /// This is the `Diagnoza` column of the paper register, which the app used to
  /// keep as free text on `Work` (see `Work.diagnosis`) — one span for a case
  /// that routinely has three pieces of work in it, believed exactly as typed,
  /// readable by nobody. Here it belongs to the line, the way it does on the
  /// docket, and `elements` above falls out of it rather than being typed twice.
  ///
  /// Optional, because plenty of work names no teeth at all: a full denture, a
  /// repair, a bite splint.
  teeth String?

  /// What is being made — a crown, a bridge, a denture, a repair.
  ///
  /// The *name*, not a link to `WorkProcedure`, for the reason `patientName` is
  /// a copy and not a lookup: this row is a record of a docket that has already
  /// left the building, and renaming an entry in the catalogue two years later
  /// must not rewrite what was sent in March. The catalogue is where the form
  /// gets its options; this is what was chosen.
  procedure String

  /// Which laboratory, as it was written on the docket.
  ///
  /// A snapshot, and kept: this row records a case that has already left the
  /// building, and renaming a laboratory two years later must not rewrite what
  /// March's slip said. Exactly the relationship `procedure` has to
  /// `WorkProcedure`, and `patientName` to `Patient`.
  lab String?

  /// Which laboratory, as a row that can be rung.
  ///
  /// The text above used to be the only answer, on the argument that "a practice
  /// sends to two or three labs whose names it already knows how to spell".
  /// Directly below it in this file, `WorkProcedure` exists because the identical
  /// argument was made for `procedure` and then reversed — a zirconia crown went
  /// out as three different strings in one week, and "nothing could be counted,
  /// and the register's whole job is counting".
  ///
  /// `lab` had the same failure mode and one consequence `procedure` did not:
  /// the follow-up board exists more or less *because* somebody has to ring the
  /// laboratory about a bridge on Thursday, and the board knew the errand and
  /// could not dial it. The dashboard's own "waiting on the laboratory" panel
  /// offered the only telephone number the register held — the **patient's** —
  /// under a heading about chasing the lab.
  ///
  /// Nullable, and `SetNull`: a case written before this existed keeps its text
  /// and has no row, and retiring a laboratory must not take the register's
  /// history with it.
  labId  String?
  labRef Lab?    @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@index([workId])
  /// "Everything we sent to this laboratory", which is the question a quarter's
  /// invoice is checked against and the reason this column exists.
  @@index([labId])
}

/// A laboratory the practice sends work to.
///
/// The same shape as `WorkProcedure` — a short list the practice keeps, and a
/// form that offers that list and nothing else — with the one addition that
/// makes it worth more than tidiness: somewhere to put the telephone number.
///
/// Deliberately not `Supplier`. A supplier sells boxes that go on a shelf and is
/// reached from the reorder list; a laboratory makes a crown for one named
/// patient and is reached from the works register and the follow-up board. They
/// share two columns and no screens, and collapsing them would put every dental
/// laboratory in the storage room's ordering list.
model Lab {
  id   String @id @default(uuid())
  name String

  /// What the follow-up board dials. The whole point of the row.
  phone String?
  email String?

  /// Anything the practice needs beside the number — a contact's name, which
  /// days they collect, what they are slow at.
  notes String?

  /// Retired, not deleted — the same rule staff, services and materials live
  /// under, and for the sharper reason here: the lines already pointing at this
  /// row are the register's record of what was sent where.
  archivedAt DateTime?

  createdAt DateTime @default(now())

  lines WorkLine[]
}

/// The kinds of work this practice sends out, named once.
///
/// `WorkLine.procedure` was a text box, and a text box asked the same question
/// on every line of every case: a *zirconia crown* was going out as "Kurorë
/// zirkoni", "kurore zirkon" and "Zirkon" in the same week. Nothing could be
/// counted, and the register's whole job is counting.
///
/// So the same shape as `StockCategory` and `ServiceCategory`: a short list the
/// practice keeps, and a form that offers that list and nothing else. Flat, with
/// no parent — a laboratory bills for a crown or a denture, and there is nothing
/// underneath either of them worth filing.
model WorkProcedure {
  id   String @id @default(uuid())
  name String

  createdAt DateTime @default(now())
}

/// How loudly a follow-up asks. Two values on purpose, like `Work.urgent`: a
/// five-level scale is an invitation to file everything at the top, and a board
/// where every line is urgent is a board with no priority on it at all.
enum FollowUpPriority {
  NORMAL
  URGENT
}

/// How often an errand comes back.
///
/// The gap this closes is the one every recurring job in a practice falls into.
/// "Order more gloves", "check the autoclave log", "chase the waste contract" —
/// each is written from scratch every month, and the month nobody writes it is
/// the month it does not happen. A board that can only be told about *this*
/// Thursday makes the practice its own scheduler.
///
/// Named intervals rather than a number of days, because half of these are
/// calendar facts and not arithmetic: an errand set for the last day of January
/// and repeating monthly is due at the end of February, not on the 2nd of March.
/// `nextDueAt` in `lib/follow-ups.ts` is where that lives, and it is pure and
/// tested precisely because month-end is where date code goes wrong.
enum FollowUpRepeat {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Something the practice has to come back to, with a day attached.
///
/// The gap this fills is narrow and real. Everything else in the app is a record
/// of what *happened* — a slot, a visit, a case, a box off the shelf — and the
/// only things that ever chased anybody were derived: a recall falls out of the
/// last visit date, a low-stock warning out of a count. None of that can hold
/// "ring the lab about Berisha's bridge on Thursday", so it lived on a sticky
/// note on the monitor, which is the system this replaces.
///
/// Deliberately *not* called a reminder. That word is taken twice over — a
/// `Contact` of purpose `REMINDER` is the message a patient gets before their
/// appointment, and `/recalls` is the list of people due back. Both are about
/// contacting a patient; this is the practice talking to itself, and giving all
/// three the same name on screen would make the bell unreadable.
///
/// The link is three optional foreign keys rather than the `entity`/`entityId`
/// pair `AuditLog` uses, because these are live rows rather than a historical
/// record: a follow-up wants to *open* the thing it is about, and it should stop
/// existing when that thing does. Cascade gives both; a loose string gives a
/// button that leads to a 404.
model FollowUp {
  id String @id @default(uuid())

  /// What to do, in one line — the words that appear in the bell.
  title String
  notes String?

  /// The day it comes up, at UTC midnight.
  ///
  /// Required, and the whole point. A follow-up with no date is a note, and the
  /// app already has somewhere to write notes on every record worth writing them
  /// on; what nothing could do was make one surface again on a chosen morning.
  dueAt DateTime

  priority FollowUpPriority @default(NORMAL)

  /// How often this one comes back, or null for a one-off — which is most of
  /// them, and the reason this is nullable rather than an enum with a `NEVER`.
  ///
  /// Kept on the line rather than in a separate schedule table: a repeating
  /// follow-up is not a template that spawns children, it is an errand that,
  /// when ticked, writes the next one and carries this field with it. That
  /// makes the history honest — twelve closed lines for twelve months of
  /// gloves, each with the day it was actually done — and it means editing the
  /// interval, or dropping it, is editing the line in front of you rather than
  /// hunting for a rule somewhere else.
  repeatEvery FollowUpRepeat?

  /// Ticked off, and by whom. Kept rather than deleted so the board can be
  /// looked back over, and so a line closed by mistake can be reopened.
  doneAt   DateTime?
  doneById String?
  doneBy   StaffUser? @relation("FollowUpCompleter", fields: [doneById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   StaffUser? @relation("FollowUpAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Whose job it is. Null means the practice's rather than a person's, which is
  /// the honest default in a clinic of four people who all answer the phone.
  assignedToId String?
  assignedTo   StaffUser? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// What it is about. At most one of these is ever set — the form offers the
  /// record it was opened from — and all three may be null, because "order more
  /// gloves" is a real follow-up that is about nothing in particular.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: Cascade)

  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  /// Photographs, scans and PDFs pinned to this errand. See `FollowUpAttachment`.
  attachments FollowUpAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The bell's own query: what is still open, soonest first. `doneAt` leads
  /// because filtering the closed lines away is the first thing every read does.
  @@index([doneAt, dueAt])
  @@index([assignedToId])
  @@index([patientId])
  @@index([workId])
  @@index([stockItemId])
}

/// A message the practice means to send, before anybody has sent it.
///
/// Everything else in this app that touches a patient is *past tense*:
/// `Contact` records what was put in front of somebody, after a human pressed a
/// link. This is the first thing that is future tense, and it exists because a
/// clock cannot press a link — something has to hold "tomorrow's six need
/// reminding" between the job that works it out and the person who acts on it.
///
/// **It stores intent, not words.** There is no body column, deliberately. The
/// wording is composed by `composeReminder` when the queue is drawn and again
/// when it is sent, so a slot that moves between those two moments cannot
/// produce a message quoting the old time — which is exactly the failure a
/// snapshotted body would cause, and the one a patient would notice. `Contact`
/// still snapshots what was actually sent, because *that* is a record of the
/// past and must never be rewritten by a later edit.
///
/// The channel is not stored either, for the same reason: which of WhatsApp,
/// email or the telephone is right depends on the patient's details and consent
/// *now*, and `Contact.channel` records which one it turned out to be.
model ScheduledMessage {
  id String @id @default(uuid())

  kind   MessageKind
  status MessageStatus @default(PENDING)

  /// What makes a clock safe to run twice.
  ///
  /// The one column that has to be unique, and the reason this table is
  /// idempotent: a job that fires at 18:00 and again at 18:05 because a deploy
  /// restarted the container must not queue tomorrow's reminders twice. Built
  /// by the rule that queues the row — `reminder:<appointmentId>` — so a kind
  /// that repeats can namespace itself by year or by month without this table
  /// needing to know how. See `src/lib/messages/outbox.ts`.
  ///
  /// Enforceable at all only because the deploy replays migrations now; under
  /// `prisma db push` a unique index could not be added, which is why nothing
  /// like this table existed before.
  dedupeKey String @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// The booking it is about, when it is about one. Cascades: a deleted slot
  /// has nothing left to remind anybody of.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// The earliest this may go out.
  ///
  /// Carries little weight while a human presses send — the queue simply shows
  /// what is due, and "quiet hours" are whatever hour the job runs at. It earns
  /// its keep the day anything sends by itself, which is why it is here now
  /// rather than added later to a table full of rows that lack it.
  sendAfter DateTime

  /// When it stopped being PENDING, and who did that. Null while it waits.
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   StaffUser? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Why it was skipped or cancelled, in one line — "no phone or email",
  /// "appointment cancelled". Never shown to a patient; this is the practice
  /// explaining itself to itself.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The queue's own question: what is still waiting, soonest first.
  @@index([status, sendAfter])
  @@index([patientId])
  @@index([appointmentId])
}

enum MessageKind {
  /// "You have an appointment tomorrow at 10:30."
  APPOINTMENT_REMINDER

  /// "It has been eight months since we last saw you."
  ///
  /// The second tenant of a table built for several. Until it existed the queue,
  /// the clock, the dedupe and the skip-reason on every declined row all served
  /// the *appointment reminder* — a courtesy about a slot the patient has
  /// already agreed to — while the recall, which is a patient nobody has seen
  /// for eight months, had a list somebody had to remember to open.
  ///
  /// `dedupeKey` carries the cycle (`recall:<patientId>:2026-08`) rather than
  /// this table growing a period column, which is the shape `dedupeKey`'s own
  /// doc comment reserved for it.
  RECALL_DUE
}

enum MessageStatus {
  /// Waiting for somebody to send it.
  PENDING
  /// Put in front of the patient. A `Contact` row records what was said.
  SENT
  /// The reason went away — the slot was cancelled, moved, or already answered.
  CANCELLED
  /// Deliberately not sent: no way to reach them, or they asked not to be.
  SKIPPED
}

/// What was waiting on the practice on one particular morning.
///
/// The reminder board answers "what is waiting" brilliantly for anybody who
/// opens it. This exists for the morning nobody does — the day off, the locum,
/// the week the owner is at a conference — and it is deliberately the *only*
/// thing in the app that is future-facing about the practice itself rather than
/// about a patient.
///
/// **It stores the numbers, not the words**, which is `ScheduledMessage`'s rule
/// and it is the same argument: a digest composed at write time and read a week
/// later would quote a board that has since been cleared, and the wording has to
/// be in the reader's language anyway. Ten integers and a date; the sentence is
/// composed when somebody looks.
///
/// **Nothing sends it.** `sentAt` is here from the first day and will stay null
/// until a human decides that the practice should be emailed its own board —
/// which is a decision about a mailer that is not configured against a real
/// domain yet, and about the line every job in this app has held so far ("it
/// still sends nothing: it fills a queue a person works down"). The row is the
/// queue. What sends it, if anything ever does, is somebody's choice later.
///
/// One row per day, and `forDay` is unique because that is what makes the clock
/// safe to run twice — the same reasoning `ScheduledMessage.dedupeKey` sets out,
/// and enforceable for the same reason: the deploy replays migrations now.
model PracticeDigest {
  id String @id @default(uuid())

  /// The morning this describes, at UTC midnight.
  forDay DateTime @unique

  /// The practice's own errands, split the way the board splits them.
  followUpsOverdue Int
  followUpsToday   Int

  /// The storage room. `ordersLate` cuts across the other two rather than
  /// adding to them — a material is usually empty *because* the order never
  /// came — so a reader must not sum these three.
  stockOut   Int
  stockLow   Int
  ordersLate Int

  /// The piles that live on other screens. Same list, same order, as
  /// `lib/board-elsewhere.ts`, which is what fills them.
  worksToChase         Int
  requestsWaiting      Int
  unreadMail           Int
  unremindedTomorrow   Int
  appointmentsUnclosed Int

  /// Null while nothing has sent this — see the note above. Kept from the
  /// beginning rather than added later to a table full of rows that lack it,
  /// which is the argument `ScheduledMessage.sendAfter` already makes.
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One run of one scheduled job, whether it worked, and what it did.
///
/// The app is overwhelmingly "pull": almost everything it knows is derived at
/// read time, which is why it needed no scheduler for so long. The few things
/// that genuinely need a clock — see §6.4 of the blueprint — had nowhere to
/// record that they had happened, and a job nobody can see the result of is a
/// job nobody notices has been failing since March.
///
/// A table rather than the status file the backup sidecar writes, and
/// deliberately: that container has no database driver and its whole subject is
/// the filesystem, whereas these run inside the app, against this database,
/// and are read by the same pages everything else is.
model JobRun {
  id String @id @default(uuid())

  /// Which job — a key in `JOBS`, see `src/lib/jobs/registry.ts`. Not an enum:
  /// a job removed from the registry should leave its history readable rather
  /// than fail to load, which is the one thing an enum here would guarantee.
  name String

  startedAt  DateTime  @default(now())
  /// Null while it is running, which is also how a crashed run is recognised:
  /// nothing ever sets this except the runner's own `finally`.
  finishedAt DateTime?

  /// Null while running, then true or false. Tri-state on purpose — "did not
  /// finish" is a different thing from "finished badly".
  ok Boolean?

  /// One line, for the log and for the screen: "9 orphans, 765 B".
  summary String?
  /// The failure, when there was one. Truncated by the runner.
  error   String?

  /// Newest run of a given job is the question every reader asks.
  @@index([name, startedAt])
}

/// A photograph, a scan or a PDF pinned to one follow-up.
///
/// Deliberately its own table rather than a `PatientDocument` with a nullable
/// patient. Two reasons, and the second is the one that decides it:
///
///  - Most follow-ups are about nothing in particular — "order more articaine
///    before Friday" — so the patient link is null far more often than not, and
///    `PatientDocument.patientId` is required precisely because a radiograph
///    without a patient is a bug.
///  - A working note is not a medical record. The photo of a cracked casting
///    somebody snapped to remember which one to ring the lab about does not
///    belong in the patient's file alongside their consent forms and their
///    X-rays, and quietly filing it there would be the app deciding something
///    the practice should decide. `saveToPatientFile` is the explicit way over.
///
/// The bytes go through the same storage layer as everything else — see
/// `files.ts` — so the on-disk name is generated, the original filename is kept
/// for display only, and nothing is reachable without a session.
model FollowUpAttachment {
  id         String   @id @default(uuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  /// As uploaded. Display only — user input never steers a filesystem path.
  fileName   String
  mimeType   String
  sizeBytes  Int
  /// Opaque on-disk name, as `PatientDocument.storageKey`.
  storageKey String @unique

  uploadedById String?
  uploadedBy   StaffUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([followUpId])
}

/// ---------------------------------------------------------------------------
/// Correspondence
/// ---------------------------------------------------------------------------
///
/// The first time this app stores something it did not derive.
///
/// Everything else here is recomputed on every render — "who is overdue", "what
/// is free on Thursday" — because a derived answer cannot go stale. An email
/// cannot be derived from anything. It arrived, it says what it says, and the
/// only copy is the one kept here. That is a real departure from §1.2 of the
/// blueprint and it is written down there rather than smuggled in under a
/// migration name.
///
/// **Why it earns the departure.** Sending had no receiving half. The app asks
/// a patient "can we move it to Thursday?", sets `Reply-To` to a mailbox, and
/// then has no idea what came back — the answer lands in somebody's Outlook and
/// the record shows a message sent into silence. A `Contact` row saying "opened
/// in a mail client" is the practice describing its own actions; a thread is the
/// conversation.

/// Everything said to and from one address.
///
/// **One thread per correspondent, not one per RFC conversation.** Mail clients
/// thread by `In-Reply-To`, so a year of writing to the same patient becomes
/// nine unrelated threads with near-identical subjects. That is the right model
/// for a mailbox and the wrong one here: nobody at a front desk wants "Re:
/// Appointment reminder (3)", they want *Dritan*, and the rest of this app is
/// already organised that way. It also means a reply always has a home, even
/// when the sender's client dropped the headers — which the cheap ones do.
///
/// The cost is that the subject stops identifying the thread and becomes the
/// latest thing it was called. That is a fair trade for a clinic exchanging a
/// dozen short messages a week with each patient, and a bad one for a helpdesk.
/// This is a clinic.
model EmailThread {
  id String @id @default(uuid())

  /// The most recent subject seen, with the `Re:` prefixes taken off. Decoration
  /// rather than identity — `correspondent` is the identity.
  subject String

  /// Who the practice is talking to, and the thread's real key.
  ///
  /// Lower-cased, because a mailbox is case-insensitive in every way that
  /// matters here and matching on the raw form would open a second thread the
  /// first time somebody's phone capitalised their own address. Unique, so that
  /// a webhook delivered twice and two people pressing send at once both land
  /// on one row rather than racing to create two.
  correspondent String @unique

  /// The patient it is about, once anybody knows. Null is ordinary and not a
  /// failure: a supplier, a lab, or a stranger. `SetNull` rather than cascade —
  /// deleting a patient must not silently destroy correspondence that may be
  /// the only record of what was agreed.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  /// Denormalised, and the one place in this schema that is.
  ///
  /// The inbox is sorted by it, and deriving it would mean an aggregate over
  /// every message on every render of a list that is read all day. Safe to
  /// store because it is append-only — a thread's last message never moves
  /// backwards — which is the property the rest of this app's derived answers
  /// lack.
  lastMessageAt DateTime

  /// Filed away by hand. Spam, mostly, and the odd finished conversation.
  archivedAt DateTime?

  createdAt DateTime       @default(now())
  messages  EmailMessage[]

  /// The inbox's own question: newest first.
  @@index([archivedAt, lastMessageAt])
  @@index([patientId, lastMessageAt])
}

model EmailMessage {
  id       String      @id @default(uuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  direction EmailDirection

  fromAddress String
  fromName    String @default("")
  toAddress   String
  subject     String

  /// Plain text. What the screen renders, always.
  text String

  /// The markup, kept and never rendered as markup.
  ///
  /// A received email is the most hostile input this app accepts — it is
  /// attacker-chosen HTML from an unauthenticated stranger — and the app has
  /// nowhere it renders untrusted markup today. Keeping it costs a column and
  /// buys "view the original", which is what somebody needs on the one day a
  /// text/plain part was missing or useless.
  html String?

  /// The message's own identity, as the outside world knows it.
  ///
  /// For an inbound message this is the RFC 5322 `Message-ID` header. For an
  /// outbound one it is whatever the provider gave back — Brevo returns the
  /// real header, Resend returns its own id, which appears *inside* the header
  /// it went out with. Matched loosely for that reason; see `matchThread`.
  ///
  /// Unique so that a webhook delivered twice — which every webhook eventually
  /// is — writes one row. That is this table's whole idempotency story, exactly
  /// as `ScheduledMessage.dedupeKey` is the outbox's.
  providerMessageId String? @unique

  /// The `In-Reply-To` header, when the sender set one.
  inReplyTo String?

  /// Null until somebody at the desk has opened it. Only ever set on inbound —
  /// the practice has by definition read what it sent itself.
  readAt DateTime?

  /// Who sent it, for outbound. Null for everything that arrived.
  actorId String?
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// What the provider thought of it, 0–10 and higher is worse. Recorded rather
  /// than acted on: a number the app silently filtered by would be a number
  /// nobody could see was wrong.
  spamScore Float?

  createdAt   DateTime          @default(now())
  attachments EmailAttachment[]

  @@index([threadId, createdAt])
  /// "What is unread", for the badge in the nav.
  @@index([direction, readAt])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// A file that arrived attached to a message.
///
/// Its own table rather than a `PatientDocument`, and for the reason
/// `FollowUpAttachment` is its own table: a stranger's attachment is not a
/// medical record, and filing it in the patient's documents automatically would
/// be the app deciding something it has no business deciding. Promoting one to
/// the record is a thing somebody does on purpose.
model EmailAttachment {
  id        String       @id @default(uuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// As sent. Display only — user input never steers a filesystem path.
  fileName   String
  mimeType   String
  sizeBytes  Int
  /// Opaque on-disk name, as `PatientDocument.storageKey`.
  storageKey String @unique

  createdAt DateTime @default(now())

  @@index([messageId])
}

/// One material's low-stock alert, waved away.
///
/// The alert itself is never stored. "This material is low" is a comparison
/// made when read — `usable <= minLimit` — for the same reason overdue-ness and
/// batch expiry are: a stored flag is a flag that goes stale the moment somebody
/// puts a box back on the shelf, and nothing would ever unset it.
///
/// What cannot be derived is a person's decision to ignore one. That is what
/// this row is: not the alert, but the answer "not now" given to it, on a day,
/// by somebody, against a shelf that held `atQuantity` boxes at the time.
///
/// Which is why the count is kept rather than just the date. A dismissal is
/// about the situation as it stood, so it expires when the situation gets
/// worse: drop below `atQuantity` and the alert is asked again, because "we can
/// live with three" is not an answer to "there is one left". Restocking above
/// the minimum clears the row outright — see `getStockAlerts`.
///
/// Ordering is the *other* answer, and it is not stored here: `StockItem.orderedAt`
/// already records it, already survives a delivery clearing it, and already
/// takes the material off the reorder list. A dismissal is "leave me alone",
/// an order is "dealt with", and collapsing the two would lose the difference.
model StockAlertDismissal {
  id String @id @default(uuid())

  /// Unique: a material has one open dismissal or none. Waving the same alert
  /// away twice is not two decisions, it is the same decision restated against
  /// a lower count — so the write is an upsert and this is what makes it one.
  stockItemId String    @unique
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  /// Usable boxes on the shelf when it was waved away — expired lots already
  /// taken off, exactly as the alert counted them.
  atQuantity Int

  dismissedAt   DateTime   @default(now())
  dismissedById String?
  dismissedBy   StaffUser? @relation(fields: [dismissedById], references: [id], onDelete: SetNull)

  @@index([dismissedById])
}

/// Somebody who has not been here yet, asking to be seen.
///
/// The first row in this database written by a person the practice has never
/// met. Everything else here is authored by staff, or derived from a patient who
/// already has a file; this is the public page's one write, and it is shaped
/// accordingly — no relation to `Patient`, no clinical column, and nothing on
/// the form that invites a stranger to type a diagnosis into an
/// unauthenticated box.
///
/// **It is deliberately not an `Appointment`.** An appointment is a promise the
/// practice has made and the calendar is answerable for; this is a request that
/// somebody at the desk still has to read, ring back and place. Writing straight
/// into the book would let anybody with a browser fill a working day, and would
/// put slots in front of the dentist that nobody had agreed to.
model AppointmentRequest {
  id String @id @default(uuid())

  /// One field, not a first name and a last one. Somebody typing on a phone
  /// should be able to write what they are called and move on; the desk splits
  /// it properly at the point a real record is created.
  name String

  /// The only channel that reliably reaches a person here, and so the only one
  /// that is required. Stored exactly as it was typed — normalising a number
  /// whose country is unknown is how a valid Italian mobile becomes unreachable.
  phone String

  email String?

  /// What they asked for, in their own words.
  ///
  /// Length is capped in the action rather than by the column: a database error
  /// is not a sentence anybody can act on, and the form has to be able to say
  /// "that is longer than this box takes" in the language the page is in.
  message String?

  /// Which treatment they picked off the page, by the key the page offers rather
  /// than a `Service` id.
  ///
  /// The catalogue is priced, renamed and reorganised for the practice's own
  /// convenience; the public list is a handful of words that stay put. Pinning
  /// one to the other would let a tidy-up on the catalogue screen silently
  /// change what the storefront says, and would leak the practice's internal
  /// naming to anybody reading the form's HTML.
  topic String?

  /// The language the page was in when this was written.
  ///
  /// The single most useful column here. This practice works in Albanian,
  /// Italian and English, and a good share of the people who fill this in are
  /// choosing between clinics in three countries — whoever rings back needs to
  /// know which language to open in before they dial.
  locale String @default("sq")

  /// The day they picked off the calendar on the booking page, at UTC midnight
  /// like every other calendar day in this database.
  ///
  /// A *preference*, and the column name is the whole of the argument: this
  /// table does not book anything, so a date here is what the visitor said would
  /// suit them and not a slot anybody is holding. The desk rings back and agrees
  /// a real time; what this buys is that the first sentence of that call is
  /// "Thursday still good?" rather than "when are you free?".
  ///
  /// Null wherever they did not say — the calendar is optional, and a request
  /// with no day on it is exactly the request this form took before it had one.
  preferredDate DateTime?

  /// `morning`, `afternoon`, or null for "either" — see `PREFERRED_TIMES`.
  ///
  /// Not a time of day. Somebody choosing between a boat on Tuesday and a
  /// morning appointment does not have an opinion about 09:20 versus 09:40, and
  /// asking for one on a public form invites a precision the practice cannot
  /// honour before it has looked at the book.
  preferredTime String?

  status AppointmentRequestStatus @default(NEW)

  /// Who picked it up, and when. Kept rather than cleared: a request that was
  /// answered is the evidence that it was answered.
  handledAt   DateTime?
  handledById String?
  handledBy   StaffUser? @relation("AppointmentRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  /// What the desk wrote after ringing back.
  staffNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// What they sent with it — a radiograph from another clinic, a quotation,
  /// a photograph of the tooth. See `AppointmentRequestAttachment`.
  attachments AppointmentRequestAttachment[]

  /// The desk's own query: what is still open, **oldest first**. A request that
  /// has been sitting for two days is more urgent than one that arrived this
  /// morning, which is the reverse of how every other list in this app is read.
  @@index([status, createdAt])
}

/// What a stranger attached to a request: an X-ray, a report, a photograph.
///
/// **The one table in this database whose bytes arrive from somebody with no
/// account**, and every column here is shaped by that. It is the same file
/// record as `FollowUpAttachment` — a display name, a verified type, a size and
/// an opaque on-disk key — with one field deliberately missing: there is no
/// `uploadedBy`, because nobody was signed in. The request is who sent it.
///
/// **Why the practice wanted this at all.** A good share of the people filling
/// in that form are choosing between clinics in three countries, and what they
/// have in their hand is an OPG from a dentist at home or a quotation from a
/// clinic in Italy. Before this, the desk read "I have an X-ray" in the message
/// box and rang back to ask for it by email, which is a second round trip on
/// the one enquiry the practice most wants to answer well.
///
/// **The type is sniffed rather than believed.** `mimeType` is what the first
/// bytes of the file actually say it is, not what the browser claimed — see
/// `sniffMimeType`. On a public endpoint the declared type is a string a
/// stranger chose, and it is the string this app later hands back to a browser
/// as `Content-Type`.
///
/// Cascades with the request. A request the desk deletes is a request whose
/// files go with it, and the row going without the bytes is what
/// `sweep-orphan-files.ts` exists to catch.
model AppointmentRequestAttachment {
  id        String             @id @default(uuid())
  requestId String
  request   AppointmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// As uploaded, capped and stripped of any path. Display only — user input
  /// never steers a filesystem path, and on this table the user is a stranger.
  fileName String

  /// The type the *bytes* are, not the type the upload claimed.
  mimeType String

  sizeBytes Int

  /// Opaque on-disk name, as `PatientDocument.storageKey`.
  storageKey String @unique

  createdAt DateTime @default(now())

  @@index([requestId])
}

enum AppointmentRequestStatus {
  /// Nobody has picked it up yet.
  NEW
  /// Somebody rang back. Whether it turned into an appointment is the calendar's
  /// business, not this table's.
  CONTACTED
  /// Dealt with, or not worth chasing — either way it leaves the list.
  CLOSED
}
