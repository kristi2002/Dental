# Production environment — the values Coolify holds for the deployed app.
# Copy the names, not these values. See docs/DEPLOYMENT.md.

# --- Runtime (can be changed and take effect on restart) --------------------

# Postgres. With the bundled docker-compose.prod.yml the host is the service
# name `db`; with Coolify's managed Postgres, use the internal URL it shows you.
DATABASE_URL="postgresql://dent:REPLACE_ME@db:5432/dentorganizer?schema=public"

# Signs the staff session cookie. Minimum 16 characters; the container refuses
# to start without it. Changing it signs everyone out.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# What the jobs sidecar proves itself with when it asks the app to run something.
# Minimum 16 characters. `/api/jobs/*` is reachable on the practice's domain like
# every other route, so this is the whole of the authority — and with it unset the
# app refuses every trigger rather than running them for anybody.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JOBS_SECRET=

# The weekly sweep reports the files it would delete and deletes nothing until
# this is `true`. Leave it off until a few JobRun rows say it is finding what you
# expect. See src/lib/jobs/registry.ts.
# JOBS_SWEEP_APPLY=false

# --- Sending email ----------------------------------------------------------
# All three, or none. With none of them set the send queue keeps opening a draft
# in whoever's mail client, which is how the app worked before and is a perfectly
# good way to run a practice — nothing degrades, one button changes.
#
# Deliberately an HTTPS API rather than SMTP: hosts block outbound 25/465/587 far
# more often than 443, and a clinic whose reminders silently fail because of a
# firewall rule is the failure this must not ship with. See
# src/lib/messages/email.ts.
#
# `brevo` (300 messages a day, free) or `resend` (100 a day, free). A practice
# sending thirty reminders a day will not reach either ceiling.
# MAIL_PROVIDER="brevo"

# The transactional API key from that provider. Not the SMTP password.
# MAIL_API_KEY="REPLACE_ME"

# Who the message comes from. `Name <address>` or a bare address. The domain must
# be one the provider has verified, or every send is refused with "rejected".
# MAIL_FROM="Klinika Dentare <no-reply@klinika.al>"

# Where a patient's reply lands. Optional, and the one option worth setting: with
# it unset the Reply-To header is omitted and an answer to a reminder goes to the
# sending address, which for a `no-reply@` mailbox is nowhere. A patient asking
# "can we move it to Thursday?" must reach somebody who reads mail.
# MAIL_REPLY_TO="info@klinika.al"

# And set SPF, DKIM and DMARC on the sending domain, or the reminders will be
# accepted by the provider and filed as spam by everybody else. The three records
# are in docs/DEPLOYMENT.md; Settings → Sending email has a test button that puts
# a message in the practice's own inbox so you can see which folder it lands in.

# Where X-rays, photos and consent forms are written. Must be a mounted volume,
# or every upload is lost on the next deploy.
FILE_STORAGE_DIR="/data/patient-files"

# Set to false to skip the schema sync the container runs at boot.
# AUTO_DB_PUSH=true

# --- Build-time (baked into the browser bundle; a change needs a REBUILD) ----
# In Coolify these belong in "Build Variables", not the runtime environment.

# Used for the links patients receive in appointment confirmations and reminders.
# Wrong value here means links that resolve nowhere.
NEXT_PUBLIC_APP_URL="https://dental.testdemo.it"

# Clinic name shown on prescriptions and in reminder messages.
NEXT_PUBLIC_CLINIC_NAME="Klinika Dentare"

# --- Backups (the `backup` service in docker-compose.prod.yml) --------------
# Full walkthrough, including how to create the bucket and the keys:
# docs/RESTORE.md. Without RESTIC_REPOSITORY the sidecar still dumps twice a
# day, but only to the server's own disk — which protects against an accidental
# delete and against nothing else.

# Backblaze B2, EU Central, via its S3-compatible endpoint. The bucket should be
# used by nothing else.
# RESTIC_REPOSITORY="s3:s3.eu-central-003.backblazeb2.com/dentorganizer-backup"

# Encrypts every byte before it leaves the server. GENERATE THIS YOURSELF AND
# PUT IT IN THE PRACTICE'S PASSWORD MANAGER BEFORE PASTING IT HERE. If the only
# copy of this string is on the machine that died, the offsite backup is
# undecryptable noise and the whole exercise was theatre.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# RESTIC_PASSWORD="REPLACE_ME_AND_KEEP_A_COPY_OFF_THIS_SERVER"

# The B2 application key, scoped to that one bucket. `keyID` then `applicationKey`.
# BACKUP_S3_KEY_ID="REPLACE_ME"
# BACKUP_S3_APPLICATION_KEY="REPLACE_ME"

# Seals the dumps that stay on this server.
#
# restic encrypts the copy that goes to the bucket. It does nothing for the
# fortnight of dumps kept on the local disk for a fast restore, and each one of
# those is every patient record, every visit, every prescription and the staff
# PIN hashes — compressed, which is not encryption. This is what a disk pulled
# out of the mini-PC, or a machine sent away for repair, would otherwise give up.
#
# One age identity; the sidecar derives the public half itself. Generate with:
#   age-keygen
# KEEP A COPY OFF THIS SERVER, beside RESTIC_PASSWORD. Without it the local
# dumps cannot be opened — including by the Sunday drill, which is how you find
# out early rather than on the day it matters.
#
# Unset, the dumps are written in the clear and the sidecar warns on every boot.
# BACKUP_LOCAL_KEY="AGE-SECRET-KEY-1REPLACE_ME_AND_KEEP_A_COPY_OFF_THIS_SERVER"

# Cron, in TZ. Twice daily and a restore drill on Sunday morning are the
# defaults; both are read at boot, so a change needs a restart.
# BACKUP_SCHEDULE="0 2,13 * * *"
# VERIFY_SCHEDULE="30 3 * * 0"
# TZ="Europe/Tirane"

# How far back the offsite copy reaches. Deduplication means the monthly
# snapshots cost almost nothing — two years of them is a handful of megabytes
# beyond the first.
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=24
