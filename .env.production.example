# Production environment — the values Coolify holds for the deployed app.
# Copy the names, not these values. See docs/DEPLOYMENT.md.

# --- Runtime (can be changed and take effect on restart) --------------------

# Postgres. With the bundled docker-compose.prod.yml the host is the service
# name `db`; with Coolify's managed Postgres, use the internal URL it shows you.
DATABASE_URL="postgresql://dent:REPLACE_ME@db:5432/dentorganizer?schema=public"

# Signs the staff session cookie. Minimum 16 characters; the container refuses
# to start without it. Changing it signs everyone out.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# Where X-rays, photos and consent forms are written. Must be a mounted volume,
# or every upload is lost on the next deploy.
FILE_STORAGE_DIR="/data/patient-files"

# Set to false to skip the schema sync the container runs at boot.
# AUTO_DB_PUSH=true

# --- Build-time (baked into the browser bundle; a change needs a REBUILD) ----
# In Coolify these belong in "Build Variables", not the runtime environment.

# Used for the links patients receive in appointment confirmations and reminders.
# Wrong value here means links that resolve nowhere.
NEXT_PUBLIC_APP_URL="https://dental.testdemo.it"

# Clinic name shown on prescriptions and in reminder messages.
NEXT_PUBLIC_CLINIC_NAME="Klinika Dentare"
