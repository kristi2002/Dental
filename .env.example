# Everything the app reads, in the order it stops working without them.
#
# Copy to `.env` for development. Only the first two are required; every other
# variable here has a default that is correct for a local machine, and the
# defaults are written beside each one so the file doubles as the reference for
# what happens when you leave it out.
#
# Production is a different list — see `.env.production.example`, which covers
# the backup sidecar and the restic repository as well. Most of the operational
# values below are set for you by `docker-compose.prod.yml`.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev with the bundled docker-compose.yml:
DATABASE_URL="postgresql://dent:dent@localhost:5432/dentorganizer?schema=public"

# Signs the staff session cookie (required in production, min 16 chars).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# In development a missing value falls back to a fixed development key, so
# sign-in works out of the box; in production `src/lib/auth/token.ts` refuses to
# load without one. It also signs the calendar feed tokens and the patient
# links in outgoing mail, so changing it invalidates every one of those.
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Baked into the browser bundle — these are BUILD-time, not runtime
# ---------------------------------------------------------------------------
# Next inlines every `NEXT_PUBLIC_*` value into the JavaScript it serves, so
# editing one of these in a running container changes nothing. In development
# that distinction is invisible because the dev server reads `.env` on every
# start; in Docker they are `--build-arg`s (Coolify: "Build Variables"), and the
# Dockerfile carries an ARG for each.

# Where the app is reachable from outside. Optional in development, where it
# falls back to http://localhost:3000.
#
# This is the one that decides whether a patient can act on what you send them:
# the opt-out link at the bottom of every message, the confirmation links, and
# the subscribe URL for the calendar feed are all absolute and all built from
# it. Set wrongly, the mail still sends and the links go nowhere.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clinic identity used in reminder messages (optional).
#
# Only the floor, not the answer: `clinicDisplayName()` prefers the name saved
# in Settings and falls back to this. Its real job is the storefront, which
# still has to render a name when the database is the thing that has failed.
NEXT_PUBLIC_CLINIC_NAME="Shehu Dental"

# The number the storefront's error page offers when a page fails to load
# (optional). Read from the database everywhere else; baked in here because that
# page exists for the case where the database is the thing that failed.
#
# Blank is a supported value and means the page shows no call button — which is
# what every build produced before this was wired through as a build argument.
NEXT_PUBLIC_CLINIC_PHONE="+355 69 000 0000"

# ---------------------------------------------------------------------------
# Sending and receiving email — all optional, and all off by default
# ---------------------------------------------------------------------------
# With none of these set the app queues messages and sends nothing, which is a
# supported way to run it: the reminder board becomes a list somebody works down
# by telephone. `MAIL_PROVIDER` is the switch — until it is set, Settings →
# Sending email reports the mailer as unconfigured and every send is refused
# before it reaches a provider.

# "brevo" or "resend". Only Brevo can receive.
# MAIL_PROVIDER="brevo"

# The provider's API key — not the SMTP password, which sits on the same page
# and fails with an auth error.
# MAIL_API_KEY="REPLACE_ME"

# Must match a sender the provider has verified, exactly, or every send comes
# back rejected.
# MAIL_FROM="Shehu Dental <no-reply@example.al>"

# Where a patient's reply goes. Worth setting even with no inbound webhook: the
# alternative is a reminder that cannot be answered.
# MAIL_REPLY_TO="info@example.al"

# Proves an inbound delivery came from the mail provider. Min 16 characters —
# below that, and while unset, `/api/mail/inbound` and `/api/mail/events` answer
# 404 to everything, which is deliberate: an unconfigured deployment must fail
# closed rather than accept mail from anybody who finds the URL.
#
# Locally, any value at least 16 characters long lets you post Brevo-shaped
# payloads at the inbox yourself — see `prisma/seed-inbox.ts`, which is the
# fastest way to get correspondence on the screen. In production it rides in the
# webhook URL as `?key=`, because Brevo's inbound hook takes a URL and nothing
# else.
# MAIL_INBOUND_SECRET="REPLACE_ME"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Proves a job trigger came from the sidecar. Same fail-closed rule as the mail
# secret: unset or under 16 characters and `/api/jobs/*` answers 404.
#
# Nothing in this app runs on a clock by itself — the sidecar in
# `docker-compose.prod.yml` knocks on that endpoint. In development there is no
# sidecar, so set this and trigger a job by hand when you want to see the queue
# fill:
#
#   curl -X POST http://localhost:3000/api/jobs/queue-recalls \
#        -H "x-jobs-secret: $JOBS_SECRET"
#
# A header, not a query parameter — unlike the mail hooks, which cannot send
# one. The registered names are in `src/lib/jobs/registry.ts`.
# JOBS_SECRET="REPLACE_ME"

# Whether the orphan-file sweep deletes what it finds. Defaults to false, which
# means it reports and removes nothing — the right default for a job whose
# subject is other people's radiographs.
# JOBS_SWEEP_APPLY="false"

# ---------------------------------------------------------------------------
# Operational — correct by default, listed so they are findable
# ---------------------------------------------------------------------------

# The clinic's wall clock, and NOT the same knob as `TZ`. Every "what day is it"
# answer in the app comes from this rather than from the server's clock, so a
# container running in UTC still books Thursday's list on Thursday. Defaults to
# Europe/Tirane.
# CLINIC_TIME_ZONE="Europe/Tirane"

# How long a session survives with nobody touching it. Defaults to 15 minutes.
# This is the number that actually protects the record — the realistic exposure
# is a chart left open on a screen the waiting room can see, not an overnight
# session.
# SESSION_IDLE_MINUTES="15"

# How many proxies in front of the app may be believed when reading a client's
# address. Defaults to 1, which is this deployment: Traefik terminates TLS and
# forwards. Raise it only if you actually add a hop — a CDN in front makes it
# two — because every hop counted here is a hop whose word is taken on trust,
# and the rate limiter is what depends on the answer.
# TRUSTED_PROXY_HOPS="1"

# Where uploaded radiographs, documents and mail attachments are written.
# Defaults to ./storage/patient-files. Set by the compose file in production, to
# a mounted volume that the backup sidecar also reads.
# FILE_STORAGE_DIR="./storage/patient-files"

# Where the backup sidecar writes its status file, mounted read-only. Absent in
# development, where there is no sidecar and the dashboard card says so rather
# than guessing.
# BACKUP_STATUS_DIR="/status"

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------

# Optional. A scratch database Prisma may create, replay migrations into, and
# drop again — needed only by `npm run db:migrate` and by the CI drift check
# (`migrate diff --from-migrations`). Leave unset in development and production:
# `npm run db:deploy` replays forward and never needs one.
# SHADOW_DATABASE_URL="postgresql://dent:dent@localhost:5432/dentorganizer_shadow?schema=public"
