# PostgreSQL connection string.
# Local dev with the bundled docker-compose.yml:
DATABASE_URL="postgresql://dent:dent@localhost:5432/dentorganizer?schema=public"

# Clinic identity used in reminder messages (optional).
NEXT_PUBLIC_CLINIC_NAME="Shehu Dental"

# The number the storefront's error page offers when a page fails to load
# (optional). Read from the database everywhere else; baked in here because that
# page exists for the case where the database is the thing that failed.
NEXT_PUBLIC_CLINIC_PHONE="+355 69 000 0000"

# Signs the staff session cookie (required in production, min 16 chars).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional. A scratch database Prisma may create, replay migrations into, and
# drop again — needed only by `npm run db:migrate` and by the CI drift check
# (`migrate diff --from-migrations`). Leave unset in development and production:
# `npm run db:deploy` replays forward and never needs one.
# SHADOW_DATABASE_URL="postgresql://dent:dent@localhost:5432/dentorganizer_shadow?schema=public"
